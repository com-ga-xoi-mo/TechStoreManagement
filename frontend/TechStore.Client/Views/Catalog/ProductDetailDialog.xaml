<ContentDialog x:Class="TechStore.Client.Views.Catalog.ProductDetailDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:models="using:TechStore.Client.Models.Catalog"
               xmlns:converters="using:TechStore.Client.Converters"
               Title="Chi tiết sản phẩm"
               CloseButtonText="Đóng"
               DefaultButton="Close"
               AutomationProperties.Name="Chi tiết sản phẩm">
    <ContentDialog.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:ImageUrlToImageSourceConverter x:Key="ImageUrlToImageSourceConverter" />
        <converters:ProductStatusToVietnameseConverter x:Key="ProductStatusConverter" />
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="680"
                  MaxWidth="920"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <Grid x:Name="DetailLayoutGrid" ColumnSpacing="20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ImageColumn" Width="*" />
                <ColumnDefinition x:Name="InfoColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutStates">
                    <VisualState x:Name="NarrowLayout" />
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="800" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ImageColumn.Width" Value="240" />
                            <Setter Target="InfoColumn.Width" Value="*" />
                            <Setter Target="ImagePanelGrid.Row" Value="0" />
                            <Setter Target="ImagePanelGrid.Column" Value="0" />
                            <Setter Target="ImagePanelGrid.ColumnSpan" Value="1" />
                            <Setter Target="DetailPanel.Row" Value="0" />
                            <Setter Target="DetailPanel.Column" Value="1" />
                            <Setter Target="DetailPanel.ColumnSpan" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="ImagePanelGrid" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                  Height="270" Background="{StaticResource TechStoreNeutralBgBrush}"
                  Visibility="{x:Bind ViewModel.IsPopulated, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutomationProperties.Name="Ảnh sản phẩm hoặc ảnh thay thế">
                <SymbolIcon Symbol="Pictures" Width="56" Height="56"
                            Foreground="{StaticResource TechStoreTextMutedBrush}" />
                <Image Source="{x:Bind ViewModel.ProductImageUrl, Mode=OneWay, Converter={StaticResource ImageUrlToImageSourceConverter}}"
                       Stretch="UniformToFill"
                       AutomationProperties.Name="Ảnh sản phẩm" />
            </Grid>

            <StackPanel x:Name="DetailPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="16"
                        Visibility="{x:Bind ViewModel.IsPopulated, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.ProductBrand, Mode=OneWay}"
                               Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ProductName, Mode=OneWay}"
                               Style="{StaticResource TechStoreHeadingTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.ProductModelId, Mode=OneWay}"
                               Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.WarrantyText, Mode=OneWay}"
                               Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ProductStatus, Mode=OneWay, Converter={StaticResource ProductStatusConverter}}"
                               Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                    <Border Style="{StaticResource TechStoreNeutralBadgeStyle}"
                            Visibility="{x:Bind ViewModel.IsPreviewData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Dữ liệu mẫu / Preview" Foreground="{StaticResource TechStoreNeutralTextBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Thông số kỹ thuật" Style="{StaticResource TechStoreSubheadingTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentSpecifications, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductSpecification">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource TechStoreCaptionTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource TechStoreBodyTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsVariantSelectorVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Cấu hình / màu sắc" Style="{StaticResource TechStoreSubheadingTextBlockStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableVariants, Mode=OneWay}"
                              SelectedValuePath="Id"
                              SelectedValue="{x:Bind ViewModel.SelectedVariantId, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Chọn biến thể sản phẩm">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ProductDetailVariant">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{x:Bind SwatchColor, Converter={StaticResource HexColorToBrushConverter}}"
                                             Stroke="{StaticResource TechStoreNeutralBorderBrush}" StrokeThickness="1" />
                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Border Style="{StaticResource TechStoreCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.CurrentSellingPrice, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource TechStoreHeadingTextBlockStyle}"
                                   Foreground="{StaticResource TechStorePrimaryBrush}"
                                   AutomationProperties.Name="Giá bán" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="SKU:" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentSku, Mode=OneWay}" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Tồn khả dụng:" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentAvailableQuantity, Mode=OneWay}" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Text="•" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentStatus, Mode=OneWay, Converter={StaticResource ProductStatusConverter}}"
                                       Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="4"
                                    Visibility="{x:Bind ViewModel.IsCostPanelVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="Thông tin vốn, chỉ dành cho preview có capability">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Giá vốn:" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.AverageCost, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                           Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Biên lợi nhuận ước tính:" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.EstimatedMargin, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                           Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" />
                <TextBlock Text="Đang tải chi tiết sản phẩm..." Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <SymbolIcon Symbol="Find" Foreground="{StaticResource TechStoreTextMutedBrush}" Width="40" Height="40" />
                <TextBlock Text="Không tìm thấy chi tiết sản phẩm." Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Visibility="{x:Bind ViewModel.IsError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Foreground="{StaticResource TechStoreDangerTextBrush}" TextWrapping="Wrap" />
                <Button Content="Thử lại" Command="{x:Bind ViewModel.RetryCommand}"
                        Style="{StaticResource TechStoreSecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
