<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Style x:Key="TechStorePanelStyle" TargetType="Border">
<Setter Property="Background" Value="{ThemeResource TechStoreSurfaceBrush}" />
<Setter Property="BorderBrush" Value="{ThemeResource TechStoreStrokeBrush}" />
<Setter Property="BorderThickness" Value="{StaticResource TechStoreStrokeThickness}" />
<Setter Property="CornerRadius" Value="{StaticResource TechStorePanelRadius}" />
<Setter Property="Padding" Value="{StaticResource TechStorePanelPadding}" />
</Style>
<Style x:Key="TechStoreButtonStyle" TargetType="Button">
<Setter Property="FontFamily" Value="{StaticResource TechStoreMediumFont}" />
<Setter Property="FontSize" Value="13" />
<Setter Property="CornerRadius" Value="{StaticResource TechStoreControlRadius}" />
<Setter Property="MinHeight" Value="{StaticResource TechStoreControlMinHeight}" />
<Setter Property="Padding" Value="14,8" />
</Style>
<Style x:Key="TechStorePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
<Setter Property="FontFamily" Value="{StaticResource TechStoreMediumFont}" />
<Setter Property="FontSize" Value="13" />
<Setter Property="CornerRadius" Value="{StaticResource TechStoreControlRadius}" />
<Setter Property="MinHeight" Value="{StaticResource TechStoreControlMinHeight}" />
<Setter Property="Padding" Value="14,8" />
</Style>
<Style x:Key="TechStoreDangerButtonStyle" TargetType="Button">
<Setter Property="FontFamily" Value="{StaticResource TechStoreMediumFont}" />
<Setter Property="FontSize" Value="13" />
<Setter Property="CornerRadius" Value="{StaticResource TechStoreControlRadius}" />
<Setter Property="MinHeight" Value="{StaticResource TechStoreControlMinHeight}" />
<Setter Property="Padding" Value="14,8" />
<Setter Property="Foreground" Value="{ThemeResource TechStoreDangerTextBrush}" /><Setter Property="Background" Value="{ThemeResource TechStoreDangerFillBrush}" />
</Style>
<Style x:Key="TechStoreQuietButtonStyle" TargetType="Button">
<Setter Property="FontFamily" Value="{StaticResource TechStoreMediumFont}" />
<Setter Property="FontSize" Value="13" />
<Setter Property="CornerRadius" Value="{StaticResource TechStoreControlRadius}" />
<Setter Property="MinHeight" Value="{StaticResource TechStoreControlMinHeight}" />
<Setter Property="Padding" Value="14,8" />
<Setter Property="Background" Value="Transparent" />
</Style>
<Style x:Key="TechStoreTextBoxStyle" TargetType="TextBox">
<Setter Property="FontFamily" Value="{StaticResource TechStoreRegularFont}" />
<Setter Property="FontSize" Value="14" /><Setter Property="MinHeight" Value="{StaticResource TechStoreControlMinHeight}" />
<Setter Property="CornerRadius" Value="{StaticResource TechStoreControlRadius}" />
<Setter Property="HorizontalAlignment" Value="Stretch" />
</Style>
<Style x:Key="TechStoreAutoSuggestBoxStyle" TargetType="AutoSuggestBox">
<Setter Property="FontFamily" Value="{StaticResource TechStoreRegularFont}" />
<Setter Property="FontSize" Value="14" /><Setter Property="MinHeight" Value="{StaticResource TechStoreControlMinHeight}" />
<Setter Property="CornerRadius" Value="{StaticResource TechStoreControlRadius}" />
<Setter Property="HorizontalAlignment" Value="Stretch" />
</Style>
<Style x:Key="TechStoreComboBoxStyle" TargetType="ComboBox">
<Setter Property="FontFamily" Value="{StaticResource TechStoreRegularFont}" />
<Setter Property="FontSize" Value="14" /><Setter Property="MinHeight" Value="{StaticResource TechStoreControlMinHeight}" />
<Setter Property="CornerRadius" Value="{StaticResource TechStoreControlRadius}" />
<Setter Property="HorizontalAlignment" Value="Stretch" />
</Style>
<Style x:Key="TechStoreFieldErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource TechStoreCaptionTextStyle}">
<Setter Property="Foreground" Value="{ThemeResource TechStoreDangerTextBrush}" />
</Style>
<Style x:Key="TechStoreTableRowStyle" TargetType="ListViewItem">
<Setter Property="MinHeight" Value="{StaticResource TechStoreRowMinHeight}" />
<Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="12,8" />
</Style>
<Style x:Key="TechStoreTableHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TechStoreCaptionTextStyle}">
<Setter Property="Foreground" Value="{ThemeResource TechStoreSecondaryTextBrush}" />
</Style>
</ResourceDictionary>
