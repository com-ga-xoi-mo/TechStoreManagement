<ContentDialog x:Class="TechStore.Client.Views.Inventory.StockDetailDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:models="using:TechStore.Client.Models.Inventory"
               xmlns:converters="using:TechStore.Client.Converters"
               Title="Chi tiết tồn kho thiết bị"
               CloseButtonText="Đóng"
               DefaultButton="Close"
               AutomationProperties.Name="Chi tiết tồn kho thiết bị">
    <ContentDialog.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StockMovementTypeLabelConverter x:Key="StockMovementTypeLabelConverter" />
        <converters:StockMovementQuantityConverter x:Key="StockMovementQuantityConverter" />
        <converters:StockMovementTimestampConverter x:Key="StockMovementTimestampConverter" />
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="680"
                  MaxWidth="920"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Spacing="16">
            <Border Style="{StaticResource TechStoreCardBorderStyle}" Padding="14">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ProductName, Mode=OneWay}"
                                   Style="{StaticResource TechStoreSubheadingTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.VariantName, Mode=OneWay}"
                                   Style="{StaticResource TechStoreBodyTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ProductIdentityText, Mode=OneWay}"
                                   Style="{StaticResource TechStoreCaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CategoryName, Mode=OneWay}"
                                   Style="{StaticResource TechStoreCaptionTextBlockStyle}"
                                   TextWrapping="Wrap" />
                        <Border Style="{StaticResource TechStoreNeutralBadgeStyle}"
                                HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.IsPreviewData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Dữ liệu mẫu · Preview" Foreground="{StaticResource TechStoreNeutralTextBrush}" />
                        </Border>
                    </StackPanel>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource TechStoreCardBorderStyle}" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Tổng tồn thực tế" Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.PhysicalQuantity, Mode=OneWay}"
                                           Style="{StaticResource TechStoreHeadingTextBlockStyle}"
                                           AutomationProperties.Name="Tổng tồn thực tế" />
                                <TextBlock Text="Số lượng vật lý tại kho" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource TechStoreCardBorderStyle}" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Sẵn sàng bán" Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.AvailableQuantity, Mode=OneWay}"
                                           Style="{StaticResource TechStoreHeadingTextBlockStyle}"
                                           Foreground="{StaticResource TechStorePrimaryBrush}"
                                           AutomationProperties.Name="Số lượng sẵn sàng bán" />
                                <TextBlock Text="Có thể bán" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource TechStoreCardBorderStyle}" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Đang giữ chỗ" Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ReservedQuantity, Mode=OneWay}"
                                           Style="{StaticResource TechStoreHeadingTextBlockStyle}"
                                           AutomationProperties.Name="Số lượng đang giữ chỗ" />
                                <TextBlock Text="Đã giữ cho đơn hàng" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TechStoreCardBorderStyle}" Padding="12">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Lịch sử biến động gần đây" Style="{StaticResource TechStoreSubheadingTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="Tối đa 5 biến động do nguồn dữ liệu cung cấp" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Làm mới"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                Style="{StaticResource TechStoreSecondaryButtonStyle}"
                                AutomationProperties.Name="Làm mới chi tiết tồn kho" />
                    </Grid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressRing IsActive="True" />
                        <TextBlock Text="Đang tải chi tiết tồn kho…" Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Spacing="8"
                                Visibility="{x:Bind ViewModel.IsNotFound, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Không tìm thấy số dư tồn kho này." Style="{StaticResource TechStoreSecondaryTextBlockStyle}"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Spacing="8"
                                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   Style="{StaticResource TechStoreErrorCaptionTextBlockStyle}"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Content="Thử lại" Command="{x:Bind ViewModel.RetryCommand}"
                                Style="{StaticResource TechStoreSecondaryButtonStyle}"
                                AutomationProperties.Name="Thử tải lại chi tiết tồn kho" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.NavigationErrorMessage, Mode=OneWay}"
                               Style="{StaticResource TechStoreErrorCaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.HasNavigationError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <StackPanel Spacing="8"
                                Visibility="{x:Bind ViewModel.HasBalance, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Không có lịch sử biến động." Style="{StaticResource TechStoreSecondaryTextBlockStyle}"
                                   Visibility="{x:Bind ViewModel.IsEmptyHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Auto" VerticalScrollMode="Disabled"
                                      Visibility="{x:Bind ViewModel.HasMovements, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      AutomationProperties.Name="Bảng lịch sử biến động tồn kho">
                            <Grid MinWidth="660">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8" Padding="8" Background="{StaticResource TechStoreNeutralBgBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NGÀY GIỜ" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="LOẠI" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="2" Text="SỐ LƯỢNG" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="3" Text="TỒN SAU" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="4" Text="GHI CHÚ" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.RecentMovements, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StockMovement">
                                            <Border BorderBrush="{StaticResource TechStoreBorderBrush}" BorderThickness="0,0,0,1"
                                                    AutomationProperties.Name="Biến động tồn kho">
                                            <Grid ColumnSpacing="8" Padding="8,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind OccurredAt, Converter={StaticResource StockMovementTimestampConverter}}"
                                                           Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Type, Converter={StaticResource StockMovementTypeLabelConverter}}"
                                                           Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind QuantityChange, Converter={StaticResource StockMovementQuantityConverter}}"
                                                           Style="{StaticResource TechStoreBodyTextBlockStyle}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind PhysicalQuantityAfter}"
                                                           Style="{StaticResource TechStoreBodyTextBlockStyle}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind Note}"
                                                           Style="{StaticResource TechStoreSecondaryTextBlockStyle}" TextWrapping="Wrap" />
                                            </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Cập nhật lần cuối:" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.LastRefreshedAt, Mode=OneWay, Converter={StaticResource StockMovementTimestampConverter}}"
                                       Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Content="Xem Serial / IMEI của sản phẩm này"
                                Command="{x:Bind ViewModel.NavigateToSerialImeiCommand}"
                                Style="{StaticResource TechStoreSecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Mở tab Serial và IMEI cho sản phẩm này" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
