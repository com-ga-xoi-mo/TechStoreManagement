<UserControl x:Class="TechStore.Client.Controls.StatCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:TechStore.Client.Controls" IsTabStop="False">
<Border Style="{StaticResource TechStorePanelStyle}" CornerRadius="{StaticResource TechStoreCardRadius}">
<StackPanel Spacing="8">
<Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TechStoreBodyTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
<Border Grid.Column="1" Background="{ThemeResource TechStoreInfoFillBrush}" CornerRadius="6" Padding="6"><IconSourceElement x:Name="MetricIcon" IconSource="{x:Bind IconSource, Mode=OneWay}" Width="20" Height="20" /></Border>
</Grid>
<StackPanel x:Name="ContentPanel" Spacing="8">
<TextBlock Style="{StaticResource TechStoreMetricTextStyle}"><Run x:Name="ValueRun"/><Run x:Name="UnitRun" FontSize="13" FontWeight="Normal" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" /></TextBlock>
<controls:StatusBadge x:Name="TrendLabel" Label="{x:Bind TrendText, Mode=OneWay}" Tone="{x:Bind Tone, Mode=OneWay}" />
<TextBlock x:Name="DetailLabel" Text="{x:Bind DetailText, Mode=OneWay}" Style="{StaticResource TechStoreBodyTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
</StackPanel>
<ProgressRing x:Name="LoadingRing" Width="28" Height="28" HorizontalAlignment="Left" AutomationProperties.Name="Đang tải số liệu" />
<TextBlock x:Name="ErrorLabel" Text="{x:Bind ErrorText, Mode=OneWay}" Style="{StaticResource TechStoreFieldErrorStyle}" AutomationProperties.LiveSetting="Polite" />
</StackPanel></Border></UserControl>