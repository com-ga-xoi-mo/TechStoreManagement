<UserControl x:Class="TechStore.Client.Views.Catalog.CategoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TechStore.Client.ViewModels.Catalog"
             xmlns:converters="using:TechStore.Client.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CategoryStatusToBrushConverter x:Key="StatusBrushConverter" />
        <converters:CategoryStatusLabelConverter x:Key="StatusLabelConverter" />
        <DataTemplate x:Key="CategoryRowTemplate" x:DataType="vm:CategoryTreeRowViewModel">
            <Grid ColumnSpacing="12" Padding="8,10" MinHeight="54"
                  BorderBrush="{StaticResource TechStoreBorderBrush}" BorderThickness="0,0,0,1"
                  AutomationProperties.Name="{x:Bind AccessibilityLabel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Indentation}" AutomationProperties.AccessibilityView="Raw" />
                    <Button Content="{x:Bind ExpansionGlyph}"
                            Command="{x:Bind ToggleExpansionCommand}"
                            IsEnabled="{x:Bind CanToggleExpansion}"
                            Width="30" Height="30" Padding="0"
                            Visibility="{x:Bind HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{x:Bind ExpandCollapseLabel}"
                            AutomationProperties.HelpText="Mở hoặc thu gọn nhánh danh mục" />
                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                               Style="{StaticResource TechStoreBodyTextBlockStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ParentLabel}" Style="{StaticResource TechStoreSecondaryTextBlockStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind ProductCount}" VerticalAlignment="Center"
                           Style="{StaticResource TechStoreBodyTextBlockStyle}"
                           AutomationProperties.Name="Số lượng sản phẩm trong danh mục" />
                <Border Grid.Column="3" VerticalAlignment="Center" Padding="8,4"
                        CornerRadius="4"
                        Background="{x:Bind IsActive, Converter={StaticResource StatusBrushConverter}}"
                        AutomationProperties.Name="{x:Bind IsActive, Converter={StaticResource StatusLabelConverter}}">
                    <TextBlock Text="{x:Bind IsActive, Converter={StaticResource StatusLabelConverter}}"
                               Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="Tìm tên danh mục"
                     Style="{StaticResource TechStoreTextBoxStyle}"
                     AutomationProperties.Name="Tìm danh mục theo tên" />
            <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                      HorizontalAlignment="Stretch"
                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                      AutomationProperties.Name="Lọc trạng thái danh mục" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding MatchedCategoryCount}" Style="{StaticResource TechStoreSubheadingTextBlockStyle}" />
            <TextBlock Text="danh mục" Style="{StaticResource TechStoreSecondaryTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PreviewMessage}" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressRing IsActive="True" />
                <TextBlock Text="Đang tải cây danh mục…" Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TechStoreErrorCaptionTextBlockStyle}"
                           TextWrapping="Wrap" />
                <Button Content="Thử lại" Command="{Binding LoadCommand}"
                        Style="{StaticResource TechStoreSecondaryButtonStyle}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <SymbolIcon Symbol="Find" Foreground="{StaticResource TechStoreTextMutedBrush}" />
                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
            </StackPanel>
            <Border Style="{StaticResource TechStoreCardBorderStyle}"
                    Visibility="{Binding CanShowContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled" AutomationProperties.Name="Cây danh mục">
                    <Grid MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12" Padding="12,10" Background="{StaticResource TechStoreNeutralBgBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Danh mục" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Danh mục cha / mô tả" Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="Sản phẩm" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="Trạng thái" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleRows}"
                                      ItemTemplate="{StaticResource CategoryRowTemplate}" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="Chỉ xem · Không hỗ trợ sửa danh mục trong màn này"
                   Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
    </Grid>
</UserControl>
