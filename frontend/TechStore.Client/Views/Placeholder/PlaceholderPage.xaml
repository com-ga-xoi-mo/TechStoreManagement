<Page x:Class="TechStore.Client.Views.Placeholder.PlaceholderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{StaticResource TechStoreCanvasBackgroundBrush}">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <SymbolIcon Symbol="Page2" Width="64" Height="64" Foreground="{StaticResource TechStoreTextMutedBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       Style="{StaticResource TechStoreHeadingTextBlockStyle}" 
                       HorizontalAlignment="Center" />
            <TextBlock Text="Phân hệ này chưa được triển khai."
                       Style="{StaticResource TechStoreSecondaryTextBlockStyle}"
                       HorizontalAlignment="Center" />
            
            <Border Style="{StaticResource TechStoreNeutralBadgeStyle}" HorizontalAlignment="Center" Margin="0,12,0,0">
                <TextBlock Text="Development Only / UI Preview" Foreground="{StaticResource TechStoreNeutralTextBrush}" FontSize="12" />
            </Border>
        </StackPanel>
    </Grid>
</Page>
