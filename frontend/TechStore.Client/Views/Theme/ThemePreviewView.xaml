<UserControl x:Class="TechStore.Client.Views.Theme.ThemePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:TechStore.Client.Converters"
             xmlns:vm="using:TechStore.Client.ViewModels.Theme">

    <UserControl.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="8,8,8,32">

            <!-- Header Section -->
            <StackPanel Spacing="4">
                <TextBlock Text="Bảng Kiểm Tra Giao Diện &amp; Design Tokens (D31 Foundation Preview)"
                           Style="{StaticResource TechStoreHeadingTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="Dành cho việc kiểm tra màu sắc, kiểu chữ, tương tác nút, ô nhập liệu và phản hồi trạng thái hệ thống."
                           Style="{StaticResource TechStoreSecondaryTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Section 1: Palette Màu Sắc (Color Palette Swatches - Wrapping layout for ~1024x768 @ 125%) -->
            <Border Style="{StaticResource TechStoreCardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="1. Bảng Màu Chuẩn (Color Palette Tokens)"
                               Style="{StaticResource TechStoreSubheadingTextBlockStyle}" TextWrapping="Wrap" />
                    
                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="180" ItemHeight="64">
                        <!-- Primary -->
                        <Border Background="{StaticResource TechStorePrimaryBrush}" CornerRadius="6" Margin="4" Padding="8">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Primary #2563EB" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Thương hiệu / Nút chính" Foreground="#FFFFFF" FontSize="10" Opacity="0.8" />
                            </StackPanel>
                        </Border>
                        <!-- Primary Hover -->
                        <Border Background="{StaticResource TechStorePrimaryHoverBrush}" CornerRadius="6" Margin="4" Padding="8">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Hover #1D4ED8" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Hover nút chính" Foreground="#FFFFFF" FontSize="10" Opacity="0.8" />
                            </StackPanel>
                        </Border>
                        <!-- Canvas -->
                        <Border Background="{StaticResource TechStoreCanvasBackgroundBrush}" BorderBrush="{StaticResource TechStoreBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4" Padding="8">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Canvas #F8FAFC" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="Nền ứng dụng" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <!-- Surface -->
                        <Border Background="{StaticResource TechStoreSurfaceBackgroundBrush}" BorderBrush="{StaticResource TechStoreBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4" Padding="8">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Surface #FFFFFF" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="Nền thẻ / Hộp thoại" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <!-- Success -->
                        <Border Background="{StaticResource TechStoreSuccessBrush}" CornerRadius="6" Margin="4" Padding="8">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Success #10B981" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Thành công" Foreground="#FFFFFF" FontSize="10" Opacity="0.8" />
                            </StackPanel>
                        </Border>
                        <!-- Warning -->
                        <Border Background="{StaticResource TechStoreWarningBrush}" CornerRadius="6" Margin="4" Padding="8">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Warning #F59E0B" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Cảnh báo / Tồn thấp" Foreground="#FFFFFF" FontSize="10" Opacity="0.8" />
                            </StackPanel>
                        </Border>
                        <!-- Danger -->
                        <Border Background="{StaticResource TechStoreDangerBrush}" CornerRadius="6" Margin="4" Padding="8">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Danger #EF4444" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Lỗi / Xóa dữ liệu" Foreground="#FFFFFF" FontSize="10" Opacity="0.8" />
                            </StackPanel>
                        </Border>
                        <!-- Neutral Border/Muted -->
                        <Border Background="{StaticResource TechStoreNeutralBgBrush}" BorderBrush="{StaticResource TechStoreNeutralBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4" Padding="8">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Neutral #F1F5F9" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="Khối trung tính" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </VariableSizedWrapGrid>
                </StackPanel>
            </Border>

            <!-- Section 2: Typography & Phân Cấp Chữ Tiếng Việt -->
            <Border Style="{StaticResource TechStoreCardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="2. Thang Phân Cấp Chữ (Typography Hierarchy &amp; Vietnamese Glyphs)"
                               Style="{StaticResource TechStoreSubheadingTextBlockStyle}" TextWrapping="Wrap" />

                    <TextBlock Text="Tiêu đề Heading 20px SemiBold: Quản Lý Chuỗi Cửa Hàng Công Nghệ TechStore"
                               Style="{StaticResource TechStoreHeadingTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Tiêu đề phụ Subheading 16px SemiBold: Danh mục Điện thoại di động &amp; Laptop cao cấp"
                               Style="{StaticResource TechStoreSubheadingTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Văn bản nội dung Body 13px: MacBook Pro 14 inch Apple M3 Pro 18GB / 512GB SSD Chính hãng Apple Việt Nam."
                               Style="{StaticResource TechStoreBodyTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Văn bản phụ Secondary 13px: Đã kích hoạt bảo hành điện tử theo Serial / IMEI trên hệ thống kho."
                               Style="{StaticResource TechStoreSecondaryTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Chú thích Caption 12px: Thời gian đồng bộ gần nhất: 12 phút trước"
                               Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                    <TextBlock Text="Nhãn siêu nhỏ MicroCaption 11px: MÃ ĐƠN HÀNG #ORD-2026-8942"
                               Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <!-- Section 3: Buttons & Controls States (Wrapping layout) -->
            <Border Style="{StaticResource TechStoreCardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="3. Trạng Thái Nút Bấm &amp; Tương Tác (Buttons &amp; Inputs)"
                               Style="{StaticResource TechStoreSubheadingTextBlockStyle}" TextWrapping="Wrap" />

                    <!-- Buttons Wrap Row -->
                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="170" ItemHeight="44">
                        <Button Content="Nút Chính (Primary)"
                                Margin="4"
                                Style="{StaticResource TechStorePrimaryButtonStyle}" />
                        
                        <Button Content="Nút Phụ (Secondary)"
                                Margin="4"
                                Style="{StaticResource TechStoreSecondaryButtonStyle}" />
                        
                        <Button Content="Nút Xóa (Danger)"
                                Margin="4"
                                Style="{StaticResource TechStoreDangerButtonStyle}" />
                        
                        <Button Content="Vô Hiệu Hóa"
                                Margin="4"
                                IsEnabled="False"
                                Style="{StaticResource TechStorePrimaryButtonStyle}" />
                    </VariableSizedWrapGrid>

                    <!-- Stack input examples so their labels and validation text can wrap in a narrow pane. -->
                    <StackPanel Spacing="12">

                        <!-- Normal Input -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Tên Thiết Bị (Normal / Focus)"
                                       Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBox Text="{x:Bind ViewModel.InputText, Mode=TwoWay}"
                                     Style="{StaticResource TechStoreTextBoxStyle}" />
                            <TextBlock Text="Nhập tên sản phẩm để tìm kiếm trong danh mục"
                                       Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Error Input -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Mã Serial / IMEI (Error State)"
                                       Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBox Text="{x:Bind ViewModel.ErrorInputText, Mode=TwoWay}"
                                     Style="{StaticResource TechStoreErrorTextBoxStyle}" />
                            <TextBlock Text="Lỗi: Mã IMEI không đúng định dạng 15 chữ số tiêu chuẩn."
                                       Style="{StaticResource TechStoreErrorCaptionTextBlockStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 4: Status Badges (4px Rectangular D31 with Dark Text for >= 4.5:1 Contrast) -->
            <Border Style="{StaticResource TechStoreCardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="4. Nhãn Trạng Thái Chữ Nhật Bo Góc 4px (Status Badges D31 Spec)"
                               Style="{StaticResource TechStoreSubheadingTextBlockStyle}" TextWrapping="Wrap" />

                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="180" ItemHeight="36">
                        <!-- Success Badge -->
                        <Border Style="{StaticResource TechStoreSuccessBadgeStyle}" Margin="4" HorizontalAlignment="Left">
                            <TextBlock Text="Đã hoàn thành" Foreground="{StaticResource TechStoreSuccessTextBrush}" FontSize="12" FontWeight="Medium" />
                        </Border>

                        <!-- Warning Badge -->
                        <Border Style="{StaticResource TechStoreWarningBadgeStyle}" Margin="4" HorizontalAlignment="Left">
                            <TextBlock Text="Chờ xử lý / Tồn thấp" Foreground="{StaticResource TechStoreWarningTextBrush}" FontSize="12" FontWeight="Medium" />
                        </Border>

                        <!-- Danger Badge -->
                        <Border Style="{StaticResource TechStoreDangerBadgeStyle}" Margin="4" HorizontalAlignment="Left">
                            <TextBlock Text="Đã hủy / Lỗi IMEI" Foreground="{StaticResource TechStoreDangerTextBrush}" FontSize="12" FontWeight="Medium" />
                        </Border>

                        <!-- Neutral Badge -->
                        <Border Style="{StaticResource TechStoreNeutralBadgeStyle}" Margin="4" HorizontalAlignment="Left">
                            <TextBlock Text="Bản nháp lưu tạm" Foreground="{StaticResource TechStoreNeutralTextBrush}" FontSize="12" FontWeight="Medium" />
                        </Border>
                    </VariableSizedWrapGrid>
                </StackPanel>
            </Border>

            <!-- Section 5: Common Feedback Examples (Loading, Empty, Error with Retry, Success Demo) -->
            <Border Style="{StaticResource TechStoreCardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="5. Mẫu Phản Hồi Trạng Thái Chung (Feedback Examples: Loading / Empty / Error / Success)"
                               Style="{StaticResource TechStoreSubheadingTextBlockStyle}" TextWrapping="Wrap" />

                    <StackPanel Spacing="12">

                        <!-- Sample A: Loading Feedback -->
                        <Border Background="{StaticResource TechStoreCanvasBackgroundBrush}"
                                BorderBrush="{StaticResource TechStoreBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                <ProgressRing IsActive="True" Width="24" Height="24" HorizontalAlignment="Center" />
                                <TextBlock Text="[Demo] Đang Tải..." FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="Đang tra cứu thiết bị mẫu" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Sample B: Empty Feedback -->
                        <Border Background="{StaticResource TechStoreCanvasBackgroundBrush}"
                                BorderBrush="{StaticResource TechStoreBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                <SymbolIcon Symbol="Find" Foreground="{StaticResource TechStoreTextMutedBrush}" />
                                <TextBlock Text="[Demo] Trống Dữ Liệu" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="Không tìm thấy sản phẩm" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Sample C: Error Feedback with Interactive Retry Command -->
                        <Border Background="{StaticResource TechStoreDangerBgBrush}"
                                BorderBrush="{StaticResource TechStoreDangerBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                <SymbolIcon Symbol="Cancel" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                                <TextBlock Text="[Demo] Báo Lỗi Mẫu" Foreground="{StaticResource TechStoreDangerTextBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.FeedbackStatusMessage, Mode=OneWay}"
                                           FontSize="10" Foreground="{StaticResource TechStoreDangerTextBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="Thử Lại"
                                        Command="{x:Bind ViewModel.RetryCommand}"
                                        Margin="0,4,0,0"
                                        Style="{StaticResource TechStoreSecondaryButtonStyle}"
                                        Padding="10,4" FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Sample D: Success Feedback -->
                        <Border Background="{StaticResource TechStoreSuccessBgBrush}"
                                BorderBrush="{StaticResource TechStoreSuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                <SymbolIcon Symbol="Accept" Foreground="{StaticResource TechStoreSuccessTextBrush}" />
                                <TextBlock Text="[Demo] Thành Công" Foreground="{StaticResource TechStoreSuccessTextBrush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="Mẫu phản hồi thành công" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 6: Currency Formatter & Icon / Image Fallback -->
            <Border Style="{StaticResource TechStoreCardBorderStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="6. Định Dạng Tiền Tệ &amp; Placeholder Hình Ảnh Dự Phòng"
                               Style="{StaticResource TechStoreSubheadingTextBlockStyle}" TextWrapping="Wrap" />

                    <StackPanel Spacing="20">

                        <!-- Left: Currency Display -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Định dạng Tiền Tệ (CurrencyConverter):"
                                       Style="{StaticResource TechStoreCaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Giá trị 34.990.000:" Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SamplePrice, Converter={StaticResource CurrencyConverter}}"
                                           FontWeight="Bold" Foreground="{StaticResource TechStorePrimaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Giá trị rỗng / Null:" Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.UnavailablePrice, Converter={StaticResource CurrencyConverter}}"
                                           FontWeight="Bold" Foreground="{StaticResource TechStoreTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Image & Icon Fallback -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Ảnh Sản Phẩm Dự Phòng (Fallback Placeholder):"
                                       Style="{StaticResource TechStoreCaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="56" Height="56" Background="{StaticResource TechStoreNeutralBgBrush}"
                                        BorderBrush="{StaticResource TechStoreBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <SymbolIcon Symbol="Pictures" Foreground="{StaticResource TechStoreTextMutedBrush}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Khối ảnh fallback chuẩn" Style="{StaticResource TechStoreBodyTextBlockStyle}" />
                                    <TextBlock Text="Hiển thị khi thiếu ảnh URL" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
