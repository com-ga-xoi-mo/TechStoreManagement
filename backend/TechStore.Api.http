POST {{host}}/api/orders
Content-Type: application/json

{
  "items": [
    {
      "productId": "{{findIphone.response.body.$.items[0].id}}",
      "variantId": "{{iphoneDetail.response.body.$.variants[0].id}}",
      "serialImeiId": "{{iphoneDevices.response.body.$.items[0].id}}"
    }
  ]
}

