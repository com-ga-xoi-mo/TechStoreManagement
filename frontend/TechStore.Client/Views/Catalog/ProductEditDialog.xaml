<ContentDialog x:Class="TechStore.Client.Views.Catalog.ProductEditDialog"
               x:Name="EditDialogRoot"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:models="using:TechStore.Client.Models.Catalog"
               xmlns:vm="using:TechStore.Client.ViewModels.Catalog"
               xmlns:converters="using:TechStore.Client.Converters"
               Title="Sửa sản phẩm"
               PrimaryButtonText="Lưu thay đổi"
               CloseButtonText="Hủy"
               DefaultButton="Primary"
               AutomationProperties.Name="Sửa sản phẩm">
    <ContentDialog.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:ImageUrlToImageSourceConverter x:Key="ImageUrlToImageSourceConverter" />
        <converters:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />

        <DataTemplate x:Key="SpecificationTemplate" x:DataType="vm:ProductEditSpecificationViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Tên thông số" Style="{StaticResource TechStoreTextBoxStyle}"
                             AutomationProperties.Name="Tên thông số kỹ thuật" />
                    <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Giá trị" Style="{StaticResource TechStoreTextBoxStyle}"
                             AutomationProperties.Name="Giá trị thông số kỹ thuật" />
                    <Button Grid.Column="2" Content="Xóa" Command="{x:Bind RemoveCommand}"
                            Style="{StaticResource TechStoreSecondaryButtonStyle}"
                            AutomationProperties.Name="Xóa thông số kỹ thuật" />
                </Grid>
                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="VariantTabTemplate" x:DataType="vm:ProductEditVariantViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" Padding="8,5">
                <Ellipse Width="12" Height="12" Fill="{x:Bind SwatchColor, Converter={StaticResource HexColorToBrushConverter}}"
                         Stroke="{StaticResource TechStoreNeutralBorderBrush}" StrokeThickness="1" />
                <TextBlock Text="{x:Bind Name}" MaxWidth="170" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="VariantEditorTemplate" x:DataType="vm:ProductEditVariantViewModel">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Tên biến thể *" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        <TextBox Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Tên biến thể" />
                        <TextBlock Text="{x:Bind NameError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="SKU biến thể *" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        <TextBox Text="{x:Bind Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="SKU biến thể" />
                        <TextBlock Text="{x:Bind SkuError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Gợi ý SKU" Command="{x:Bind RequestSkuSuggestionCommand}"
                            Style="{StaticResource TechStoreSecondaryButtonStyle}" AutomationProperties.Name="Gợi ý SKU biến thể" />
                    <TextBlock Text="{x:Bind SkuOriginMessage, Mode=OneWay}" Style="{StaticResource TechStoreCaptionTextBlockStyle}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Barcode (không bắt buộc)" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        <TextBox Text="{x:Bind Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Barcode biến thể" />
                        <TextBlock Text="{x:Bind BarcodeError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Giá bán biến thể (VND) *" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        <TextBox Text="{x:Bind SellingPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Giá bán biến thể" />
                        <TextBlock Text="{x:Bind PriceError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                    </StackPanel>
                </Grid>
                <StackPanel Visibility="{x:Bind CanEditCost, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Spacing="4">
                    <TextBlock Text="Giá vốn biến thể (VND)" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                    <TextBox Text="{x:Bind CostPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Giá vốn biến thể" />
                    <TextBlock Text="{x:Bind CostPriceError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Thông số riêng của biến thể" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind Specifications, Mode=OneWay}" ItemTemplate="{StaticResource SpecificationTemplate}" />
                    <TextBlock Text="{x:Bind SpecificationsError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                    <Button Content="+ Thêm thông số biến thể" Command="{x:Bind AddSpecificationCommand}"
                            Style="{StaticResource TechStoreSecondaryButtonStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Tồn hiện tại (chỉ đọc):" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind AvailableQuantity}" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                </StackPanel>
                <Button Content="Xóa biến thể khỏi bản nháp" Command="{x:Bind RemoveCommand}"
                        IsEnabled="{x:Bind CanRemove, Mode=OneWay}" Style="{StaticResource TechStoreSecondaryButtonStyle}"
                        AutomationProperties.Name="Xóa biến thể khỏi bản nháp" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="680" MaxWidth="980" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid RowSpacing="12">
            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <ProgressRing IsActive="True" />
                <TextBlock Text="Đang tải sản phẩm..." Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
            </StackPanel>
            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <SymbolIcon Symbol="Find" Width="38" Height="38" Foreground="{StaticResource TechStoreTextMutedBrush}" />
                <TextBlock Text="{x:Bind ViewModel.LoadMessage, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
            </StackPanel>
            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsLoadError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <TextBlock Text="{x:Bind ViewModel.LoadMessage, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}"
                           TextWrapping="Wrap" />
                <Button Content="Thử tải lại" Command="{x:Bind ViewModel.RetryCommand}"
                        Style="{StaticResource TechStoreSecondaryButtonStyle}" />
            </StackPanel>

            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.IsPopulated, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource TechStoreNeutralBadgeStyle}" HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.IsPreviewData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="DỮ LIỆU PREVIEW — chưa lưu lên server" Foreground="{StaticResource TechStoreNeutralTextBrush}" />
                </Border>
                <TextBlock Text="{x:Bind ViewModel.ProvenanceMessage, Mode=OneWay}"
                           Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextWrapping="Wrap" />

                <Border Style="{StaticResource TechStoreCardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Thông tin sản phẩm" Style="{StaticResource TechStoreSubheadingTextBlockStyle}" />
                        <Grid Height="150" Background="{StaticResource TechStoreNeutralBgBrush}"
                              AutomationProperties.Name="Ảnh sản phẩm hoặc ảnh thay thế">
                            <SymbolIcon Symbol="Pictures" Width="42" Height="42" Foreground="{StaticResource TechStoreTextMutedBrush}" />
                            <Image x:Name="ProductImage" Source="{x:Bind ViewModel.ImageUrl, Mode=OneWay, Converter={StaticResource ImageUrlToImageSourceConverter}}"
                                   Stretch="Uniform" ImageFailed="OnProductImageFailed" ImageOpened="OnProductImageOpened"
                                   AutomationProperties.Name="Ảnh sản phẩm preview" />
                        </Grid>
                        <TextBlock Text="Đường dẫn ảnh (preview URL; không tải tệp lên)" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        <TextBox x:Name="ImageUrlTextBox" Text="{x:Bind ViewModel.ImageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="https://..." Style="{StaticResource TechStoreTextBoxStyle}"
                                 TextChanged="OnImageUrlTextChanged"
                                 AutomationProperties.Name="Đường dẫn ảnh sản phẩm" />
                        <TextBlock Text="{x:Bind ViewModel.ImagePreviewMessage, Mode=OneWay}"
                                   Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tên sản phẩm *" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <TextBox x:Name="NameTextBox" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Tên sản phẩm" />
                                <TextBlock Text="{x:Bind ViewModel.NameError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Thương hiệu *" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <TextBox x:Name="BrandTextBox" Text="{x:Bind ViewModel.Brand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Thương hiệu sản phẩm" />
                                <TextBlock Text="{x:Bind ViewModel.BrandError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Danh mục *" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <ComboBox x:Name="CategoryComboBox" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                          SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.CategoryId, Mode=TwoWay}"
                                          AutomationProperties.Name="Danh mục sản phẩm">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CategoryOption"><TextBlock Text="{x:Bind Name}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{x:Bind ViewModel.CategoryError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Mã model" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <TextBox x:Name="ModelIdTextBox" Text="{x:Bind ViewModel.ModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Mã model sản phẩm" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="SKU sản phẩm *" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <TextBox x:Name="ProductSkuTextBox" Text="{x:Bind ViewModel.ProductSku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="SKU sản phẩm" />
                                <TextBlock Text="{x:Bind ViewModel.ProductSkuError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Barcode" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <TextBox x:Name="BarcodeTextBox" Text="{x:Bind ViewModel.Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Barcode sản phẩm" />
                                <TextBlock Text="{x:Bind ViewModel.BarcodeError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                            </StackPanel>
                        </Grid>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.IsSerialTracked, Mode=OneWay}" IsEnabled="False"
                                      Header="Quản lý từng máy bằng Serial / IMEI (chỉ đọc)"
                                      AutomationProperties.Name="Chế độ quản lý Serial hoặc IMEI chỉ đọc" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TechStoreCardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Thông số phần cứng" Style="{StaticResource TechStoreSubheadingTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Specifications, Mode=OneWay}" ItemTemplate="{StaticResource SpecificationTemplate}" />
                        <TextBlock Text="{x:Bind ViewModel.SpecificationsError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                        <Button Content="+ Thêm thông số" Command="{x:Bind ViewModel.AddSpecificationCommand}"
                                Style="{StaticResource TechStoreSecondaryButtonStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TechStoreCardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Giá và biến thể" Style="{StaticResource TechStoreSubheadingTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Giá niêm yết (VND) *" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <TextBox x:Name="BasePriceTextBox" Text="{x:Bind ViewModel.BasePriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Giá niêm yết" />
                                <TextBlock Text="{x:Bind ViewModel.BasePriceError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4"
                                        Visibility="{x:Bind ViewModel.IsCostFieldsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Giá vốn tham chiếu (VND)" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                                <TextBox x:Name="CostPriceTextBox" Text="{x:Bind ViewModel.CostPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.Name="Giá vốn tham chiếu" />
                                <TextBlock Text="{x:Bind ViewModel.CostPriceError, Mode=OneWay}" Foreground="{StaticResource TechStoreDangerTextBrush}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Biến thể hiện có" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        <ListView ItemsSource="{x:Bind ViewModel.Variants, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedVariant, Mode=TwoWay}"
                                  SelectionMode="Single" ItemTemplate="{StaticResource VariantTabTemplate}"
                                  AutomationProperties.Name="Các tab biến thể">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ScrollViewer.HorizontalScrollMode>Enabled</ScrollViewer.HorizontalScrollMode>
                            <ScrollViewer.HorizontalScrollBarVisibility>Auto</ScrollViewer.HorizontalScrollBarVisibility>
                            <ScrollViewer.VerticalScrollMode>Disabled</ScrollViewer.VerticalScrollMode>
                            <ScrollViewer.VerticalScrollBarVisibility>Disabled</ScrollViewer.VerticalScrollBarVisibility>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="+ Thêm biến thể" Command="{x:Bind ViewModel.AddVariantCommand}"
                                    Style="{StaticResource TechStoreSecondaryButtonStyle}" />
                            <TextBlock Text="SKU gợi ý chỉ tham khảo; server mới xác định tính duy nhất."
                                       Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <ContentControl Content="{x:Bind ViewModel.SelectedVariant, Mode=OneWay}"
                                        ContentTemplate="{StaticResource VariantEditorTemplate}"
                                        Visibility="{x:Bind ViewModel.HasSelectedVariant, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TechStoreWarningBadgeStyle}">
                    <TextBlock Text="Tồn kho và danh sách Serial/IMEI không thay đổi ở màn sửa sản phẩm. Không có thao tác xóa sản phẩm; xóa thuộc UI-16."
                               Foreground="{StaticResource TechStoreWarningTextBrush}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="Đang lưu thay đổi preview..." Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.SaveMessage, Mode=OneWay}"
                           Foreground="{StaticResource TechStoreDangerTextBrush}" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.IsSaveError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
