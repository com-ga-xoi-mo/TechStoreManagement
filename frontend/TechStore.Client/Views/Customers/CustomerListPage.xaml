<Page x:Class="TechStore.Client.Views.Customers.CustomerListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TechStore.Client.Controls"
      xmlns:shell="using:TechStore.Client.Views.Shell"
      Background="{ThemeResource TechStoreCanvasBrush}"
      FontFamily="{StaticResource TechStoreRegularFont}">
    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="Khách hàng" Style="{StaticResource TechStoreHeadingTextStyle}" />
            <TextBlock Text="Hồ sơ và chương trình khách hàng sẽ được kết nối qua API." Style="{StaticResource TechStoreCaptionTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsLoading), Mode=OneWay}" />
            <controls:EmptyStateControl Title="Chưa có khách hàng"
                Description="Hồ sơ khách hàng sẽ xuất hiện sau khi kết nối dịch vụ Customers."
                IconSource="{StaticResource TechStoreEmptyIcon}"
                Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsEmpty), Mode=OneWay}" />
            <StackPanel Spacing="12" Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsError), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource TechStoreFieldErrorStyle}" />
                <Button Content="Thử tải lại" Command="{x:Bind ViewModel.RetryCommand}" Style="{StaticResource TechStoreButtonStyle}" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
