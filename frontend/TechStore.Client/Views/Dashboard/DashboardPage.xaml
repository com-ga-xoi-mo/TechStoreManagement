<Page x:Class="TechStore.Client.Views.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TechStore.Client.Controls"
      xmlns:vm="using:TechStore.Client.ViewModels.Dashboard"
      xmlns:shell="using:TechStore.Client.Views.Shell"
      Background="{ThemeResource TechStoreCanvasBrush}"
      FontFamily="{StaticResource TechStoreRegularFont}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageRoot" Padding="24" RowSpacing="18" SizeChanged="OnPageSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Tổng quan kinh doanh" Style="{StaticResource TechStoreHeadingTextStyle}" />
                    <TextBlock Text="Bản phát triển — chưa đăng nhập" Style="{StaticResource TechStoreCaptionTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="PeriodSelector" Header="Kỳ thống kê minh họa" ItemsSource="{x:Bind ViewModel.Periods}"
                              DisplayMemberPath="Label" SelectedIndex="{x:Bind ViewModel.SelectedPeriodIndex, Mode=OneWay}"
                              SelectionChanged="OnPeriodSelectionChanged" IsEnabled="{x:Bind ViewModel.CanChangePeriod, Mode=OneWay}"
                              MinWidth="170" Style="{StaticResource TechStoreComboBoxStyle}" />
                    <Button Content="Làm mới" Command="{x:Bind ViewModel.RefreshCommand}"
                            IsEnabled="{x:Bind ViewModel.CanChangePeriod, Mode=OneWay}"
                            Style="{StaticResource TechStoreButtonStyle}" VerticalAlignment="Bottom" />
                </StackPanel>
            </Grid>

            <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsDemoMode, Mode=OneWay}" IsClosable="False"
                     Severity="Informational" Title="Dữ liệu minh họa — chưa kết nối Analytics API"
                     Message="{x:Bind ViewModel.ReferenceLabel, Mode=OneWay}" />
            <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}" IsClosable="False"
                     Severity="Informational" Title="Thống kê chưa tích hợp"
                     Message="Dashboard Analytics chưa có API. Không hiển thị số liệu giả khi chế độ minh họa đang tắt." />
            <StackPanel Grid.Row="1" Spacing="6" Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsError), Mode=OneWay}">
                <InfoBar IsOpen="{x:Bind ViewModel.IsError, Mode=OneWay}" IsClosable="False"
                         Severity="Error" Title="Không tải được Dashboard" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <Button Content="Thử lại" Command="{x:Bind ViewModel.RetryCommand}"
                        Style="{StaticResource TechStoreButtonStyle}" HorizontalAlignment="Left" />
            </StackPanel>

            <Grid x:Name="MetricGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <controls:StatCard x:Name="SalesCard" Title="Doanh thu" ValueText="{x:Bind ViewModel.RevenueText, Mode=OneWay}"
                    UnitText="₫" TrendText="{x:Bind ViewModel.RevenueTrendText, Mode=OneWay}" DetailText="Theo kỳ đã chọn"
                    IconSource="{StaticResource TechStoreMoneyIcon}" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <controls:StatCard x:Name="OrdersCard" Grid.Column="1" Title="Đơn hàng" ValueText="{x:Bind ViewModel.OrdersText, Mode=OneWay}"
                    UnitText="đơn" TrendText="{x:Bind ViewModel.OrdersTrendText, Mode=OneWay}" DetailText="Phát sinh trong kỳ"
                    IconSource="{StaticResource TechStoreBagIcon}" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <controls:StatCard x:Name="ProductsCard" Grid.Column="2" Title="Sản phẩm" ValueText="{x:Bind ViewModel.ProductsText, Mode=OneWay}"
                    UnitText="sản phẩm" DetailText="{x:Bind ViewModel.ProductDetailText, Mode=OneWay}"
                    IconSource="{StaticResource TechStoreBoxIcon}" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <controls:StatCard x:Name="InventoryCard" Grid.Column="3" Title="Cảnh báo tồn thấp" ValueText="{x:Bind ViewModel.LowStockText, Mode=OneWay}"
                    UnitText="mặt hàng" TrendText="{x:Bind ViewModel.LowStockTrendText, Mode=OneWay}" DetailText="{x:Bind ViewModel.LowStockDetailText, Mode=OneWay}"
                    Tone="Warning" IconSource="{StaticResource TechStoreWarningIcon}" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </Grid>

            <controls:EmptyStateControl Grid.Row="3" Title="Thống kê chưa tích hợp"
                Description="Bật chế độ Dashboard minh họa để xem bố cục mẫu. Không có dữ liệu Analytics API được yêu cầu."
                IconSource="{StaticResource TechStoreEmptyIcon}"
                Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsUnavailable), Mode=OneWay}" />

            <Grid x:Name="MainPanelGrid" Grid.Row="3" ColumnSpacing="16" RowSpacing="16"
                  Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.ShowPreviewPanels), Mode=OneWay}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="RevenuePanel" Style="{StaticResource TechStorePanelStyle}" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Xu hướng doanh thu theo ngày" Style="{StaticResource TechStoreSectionTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ReferenceLabel, Mode=OneWay}" Style="{StaticResource TechStoreCaptionTextStyle}"
                                   Foreground="{ThemeResource TechStoreSecondaryTextBrush}" TextWrapping="Wrap" />
                        <Canvas x:Name="RevenueCanvas" Height="230" SizeChanged="OnRevenueCanvasSizeChanged"
                                AutomationProperties.Name="Biểu đồ doanh thu minh họa; bảng giá trị theo ngày nằm bên dưới.">
                            <Polyline x:Name="RevenueTrendLine" Stroke="{ThemeResource TechStorePrimaryBrush}" StrokeThickness="3" />
                        </Canvas>
                        <Expander Header="Bảng số liệu doanh thu theo ngày">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DailyRevenueRows, Mode=OneWay}"
                                      AutomationProperties.Name="Doanh thu theo ngày, bảng số liệu">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardDailyRevenueRow">
                                    <Grid ColumnSpacing="12" Padding="4,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind DateText, Mode=OneWay}" Style="{StaticResource TechStoreCaptionTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind RevenueText, Mode=OneWay}" Style="{StaticResource TechStoreMonoTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border x:Name="LowStockPanel" Grid.Column="1" Style="{StaticResource TechStorePanelStyle}" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Tồn kho thấp" Style="{StaticResource TechStoreSectionTextStyle}" />
                            <controls:StatusBadge Grid.Column="1" Label="Minh họa" Tone="Warning" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.LowStockRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DashboardLowStockRow">
                                    <Grid Padding="0,9" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind ProductName}" Style="{StaticResource TechStoreBodyTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind VariantDescription}" Style="{StaticResource TechStoreCaptionTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind AvailableText}" Style="{StaticResource TechStoreBodyTextStyle}" Foreground="{ThemeResource TechStoreDangerTextBrush}" />
                                            <TextBlock Text="máy" Style="{StaticResource TechStoreCaptionTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource TechStorePanelStyle}" Padding="20"
                    Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.ShowPreviewPanels), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Đơn hàng phát sinh gần nhất" Style="{StaticResource TechStoreSectionTextStyle}" />
                            <TextBlock Text="Tối đa 5 dòng minh họa · không liên kết hồ sơ thật" Style="{StaticResource TechStoreCaptionTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentOrderRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DashboardRecentOrderRow">
                                <Grid Padding="8,10" ColumnSpacing="14" RowSpacing="7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind DemoDisplayId}" Style="{StaticResource TechStoreBodyTextStyle}" Foreground="{ThemeResource TechStoreInfoTextBrush}" />
                                        <TextBlock Text="{x:Bind CustomerDisplayName}" Style="{StaticResource TechStoreCaptionTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind TotalText}" Style="{StaticResource TechStoreMonoTextStyle}" HorizontalAlignment="Right" />
                                        <controls:StatusBadge Label="{x:Bind StatusLabel}" Tone="Neutral" />
                                        <TextBlock Text="{x:Bind CreatedAtText}" Style="{StaticResource TechStoreCaptionTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind ProductSummary}" Style="{StaticResource TechStoreBodyTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind SerialLabel}" Style="{StaticResource TechStoreCaptionTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
