# Checks to run in the database after the requests above:
#   SELECT status, warranty_start_at, warranty_end_at FROM serial_imeis WHERE status = 'Sold';   -- Sold devices carry warranty dates
#   SELECT quantity, reserved_quantity FROM inventory_stocks;                                    -- reserved_quantity back to 0
#   SELECT movement_type, quantity_change, quantity_after, order_item_id, performed_by_user_id
#     FROM inventory_movements WHERE movement_type = 'Sale';                                     -- performed_by_user_id = 11111111-1111-1111-1111-111111111111
#   SELECT order_code, status, paid_at, completed_at, cashier_user_id FROM orders ORDER BY created_at DESC;

# ===== Catalog write endpoints (UC-PROD-04/05) =====

### W1. (a) Login as Cashier
# @name loginCashier
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "cashier1", "password": "Cashier@123" }

### W2. (b) Category tree
# @name categoryTree
GET {{host}}/api/categories/tree
Accept: application/json

### W3. (c) Create product 1
# @name createWrite1
POST {{host}}/api/products
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": "{{categoryTree.response.body.$[0].id}}",
  "name": "Test Write Mouse",
  "sku": "TEST-WRITE-001",
  "brand": "TestBrand",
  "basePrice": 500000,
  "costPrice": 300000,
  "isSerialTracked": false,
  "specs": {
    "dpi": 1600
  }
}

### W4. (d) Update product 1 - price and specs
PUT {{host}}/api/products/{{createWrite1.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": "{{categoryTree.response.body.$[0].id}}",
  "name": "Test Write Mouse",
  "brand": "TestBrand",
  "basePrice": 550000,
  "costPrice": 300000,
  "isSerialTracked": false,
  "specs": {
    "dpi": 3200,
    "weight_g": 80
  }
}

### W5. (e) Add variant to product 1
# @name addVariantWrite1
PUT {{host}}/api/products/{{createWrite1.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": "{{categoryTree.response.body.$[0].id}}",
  "name": "Test Write Mouse",
  "brand": "TestBrand",
  "basePrice": 550000,
  "costPrice": 300000,
  "isSerialTracked": false,
  "specs": {
    "dpi": 3200,
    "weight_g": 80
  },
  "variants": [
    {
      "variantName": "Black",
      "sku": "TEST-WRITE-001-BK",
      "price": 550000
    }
  ]
}

### W6. (f) Reject changing existing variant SKU
PUT {{host}}/api/products/{{createWrite1.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{
  "categoryId": "{{categoryTree.response.body.$[0].id}}",
  "name": "Test Write Mouse",
  "brand": "TestBrand",
  "basePrice": 550000,
  "costPrice": 300000,
  "isSerialTracked": false,
  "specs": {
    "dpi": 3200,
    "weight_g": 80
  },
  "variants": [
    {
      "id": "{{addVariantWrite1.response.body.$.variants[0].id}}",
      "variantName": "Black",
      "sku": "TEST-WRITE-001-XX",
      "price": 550000
    }
  ]
}

### W7. (g) Deactivate product 1
PATCH {{host}}/api/products/{{createWrite1.response.body.$.id}}/status
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "isActive": false }

### W8. (g2) Deactivate product 1 again (idempotent)
PATCH {{host}}/api/products/{{createWrite1.response.body.$.id}}/status
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "isActive": false }

### W9. (g3) Reactivate product 1
PATCH {{host}}/api/products/{{createWrite1.response.body.$.id}}/status
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{ "isActive": true }

### W10. (g4) Status without isActive (400 Bad Request)
PATCH {{host}}/api/products/{{createWrite1.response.body.$.id}}/status
Authorization: Bearer {{loginAdmin.response.body.$.accessToken}}
Content-Type: application/json

{}

### W11. (h) Delete product 1 (204 No Content)
