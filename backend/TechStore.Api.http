###############################################################################
# ORDERS (UC-ORD-01..04)
# Run 50-53 first: they cache the ids (product, variant, InStock devices) that
# the later requests read through named responses, so no id is hard-coded.
# The seeded iPhone has 4 InStock devices: [0] full flow, [1] cash shortcut,
# [2] race between two pending orders. Start from a freshly seeded database.
###############################################################################

### 50. Lookup iPhone product
# @name findIphone
GET {{host}}/api/products?q=IP15PM-256-NT
Accept: application/json

### 51. Lookup iPhone detail (variant id)
# @name iphoneDetail
GET {{host}}/api/products/{{findIphone.response.body.$.items[0].id}}
Accept: application/json

### 52. Lookup InStock iPhone devices
# @name iphoneDevices
GET {{host}}/api/inventory/serials?status=InStock&productId={{findIphone.response.body.$.items[0].id}}
Accept: application/json

### 53. Lookup Sony headphones (not serial-tracked)
# @name findSony
GET {{host}}/api/products?q=SONY-WH1000XM5
Accept: application/json

### 54. Create order - walk-in, one iPhone device (201 Created, status Pending, code ORD-yyyyMM-NNNN)
# @name createOrder
POST {{host}}/api/orders
Content-Type: application/json

{
  "paymentMethod": "Cash",
  "notes": "Walk-in sale",
  "items": [
    {
      "productId": "{{findIphone.response.body.$.items[0].id}}",
      "variantId": "{{iphoneDetail.response.body.$.variants[0].id}}",
      "serialImeiId": "{{iphoneDevices.response.body.$.items[0].id}}"
    }
  ]
}

### 55. Order detail (200 OK, line shows the IMEI)
GET {{host}}/api/orders/{{createOrder.response.body.$.id}}
Accept: application/json

### 56. List pending orders (200 OK)
GET {{host}}/api/orders?status=pending
Accept: application/json

### 57. Search by order code (200 OK)
GET {{host}}/api/orders?q={{createOrder.response.body.$.orderCode}}
Accept: application/json

### 58. Pending -> Processing (200 OK: device Reserved, reserved_quantity +1, paid_at set)
PATCH {{host}}/api/orders/{{createOrder.response.body.$.id}}/status
Content-Type: application/json

{ "targetStatus": "Processing" }

### 59. Processing -> Cancelled (409 Conflict: paid orders use the refund flow)
PATCH {{host}}/api/orders/{{createOrder.response.body.$.id}}/status
Content-Type: application/json

{ "targetStatus": "Cancelled" }

### 60. Processing -> Completed (200 OK: device Sold + warranty, stock -1, Sale movement)
PATCH {{host}}/api/orders/{{createOrder.response.body.$.id}}/status
Content-Type: application/json

{ "targetStatus": "Completed" }

### 61. Completed -> Completed again (409 Conflict, nothing changes)
PATCH {{host}}/api/orders/{{createOrder.response.body.$.id}}/status
Content-Type: application/json

{ "targetStatus": "Completed" }

### 62. Create order for the cash shortcut (device [1])
# @name createShortcutOrder
POST {{host}}/api/orders
Content-Type: application/json

{
  "items": [
    {
      "productId": "{{findIphone.response.body.$.items[0].id}}",
      "variantId": "{{iphoneDetail.response.body.$.variants[0].id}}",
      "serialImeiId": "{{iphoneDevices.response.body.$.items[1].id}}"
    }
  ]
}

### 63. Pending -> Completed in one step (200 OK, paid_at = completed_at)
PATCH {{host}}/api/orders/{{createShortcutOrder.response.body.$.id}}/status
Content-Type: application/json

{ "targetStatus": "Completed" }

### 64. Race, order A: pending order holding device [2]
# @name createRaceA
POST {{host}}/api/orders
Content-Type: application/json

{
  "items": [
    {
      "productId": "{{findIphone.response.body.$.items[0].id}}",
      "variantId": "{{iphoneDetail.response.body.$.variants[0].id}}",
      "serialImeiId": "{{iphoneDevices.response.body.$.items[2].id}}"
    }
  ]
}

### 65. Race, order B: a second pending order for the same device (still 201, drafts reserve nothing)
# @name createRaceB
POST {{host}}/api/orders
Content-Type: application/json

{
  "items": [
    {
      "productId": "{{findIphone.response.body.$.items[0].id}}",
      "variantId": "{{iphoneDetail.response.body.$.variants[0].id}}",
      "serialImeiId": "{{iphoneDevices.response.body.$.items[2].id}}"
    }
  ]
}

### 66. Race: complete A (200 OK)
PATCH {{host}}/api/orders/{{createRaceA.response.body.$.id}}/status
Content-Type: application/json

{ "targetStatus": "Completed" }

### 67. Race: complete B (409 Conflict, B stays Pending, device stays Sold for A)
PATCH {{host}}/api/orders/{{createRaceB.response.body.$.id}}/status
Content-Type: application/json

{ "targetStatus": "Completed" }

### 68. Cancel the losing pending order B (200 OK, no inventory touched)
PATCH {{host}}/api/orders/{{createRaceB.response.body.$.id}}/status
Content-Type: application/json

{ "targetStatus": "Cancelled" }

