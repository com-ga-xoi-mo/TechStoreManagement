@host = http://localhost:5176

### 0a. Login as Admin (needed by product write requests)
# @name loginAdmin
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "admin", "password": "Admin@123" }

### 0. Named Lookup for MacBook Pro (Dynamic ID Reference)
# @name findMacbook
GET {{host}}/api/products?q=MBP14-M3-512
Accept: application/json

### 1. Get Product Detail by ID - Success (200 OK)
GET {{host}}/api/products/{{findMacbook.response.body.$.items[0].id}}
Accept: application/json

### 2. Get Product Detail - Unknown ID (404 Not Found)
GET {{host}}/api/products/00000000-0000-0000-0000-000000000000
Accept: application/problem+json

### 3. Search Products - Default Listing (200 OK)
GET {{host}}/api/products
Accept: application/json

### 4. Search Products - Keyword 'iphone' (200 OK)
GET {{host}}/api/products?q=iphone
Accept: application/json

### 5. Search Products - Variant SKU 'IP15PM-256-NT' (200 OK)
GET {{host}}/api/products?q=IP15PM-256-NT
Accept: application/json

### 6. Search Products - Filter by Brand 'apple' (200 OK)
GET {{host}}/api/products?brand=apple
Accept: application/json

### 6a. Search Products - Filter by Brand Wildcard '%' (200 OK with 0 items)
GET {{host}}/api/products?brand=%25
Accept: application/json

### 6b. Search Products - Filter by Brand Wildcard 'a_ple' (200 OK with 0 items)
GET {{host}}/api/products?brand=a_ple
Accept: application/json

### 7. Search Products - Filter by Category Laptops (200 OK)
GET {{host}}/api/products?categoryId={{findMacbook.response.body.$.items[0].categoryId}}
Accept: application/json

