<UserControl x:Name="StockListRoot" x:Class="TechStore.Client.Views.Inventory.StockListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:TechStore.Client.Models.Inventory"
             xmlns:converters="using:TechStore.Client.Converters"
             Background="Transparent">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:CurrencyConverter x:Key="CurrencyConverter" />
        <converters:InventoryStockStatusLabelConverter x:Key="StockStatusLabelConverter" />
        <DataTemplate x:Key="StockBalanceTemplate" x:DataType="models:StockBalance">
            <Grid ColumnSpacing="14" Padding="12,11" MinHeight="60"
                  BorderBrush="{StaticResource TechStoreBorderBrush}" BorderThickness="0,0,0,1"
                  AutomationProperties.Name="{x:Bind ProductName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ProductName}" Style="{StaticResource TechStoreBodyTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ProductSku}" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}" />
                    <TextBlock Text="{x:Bind VariantName}" Style="{StaticResource TechStoreSecondaryTextBlockStyle}" TextWrapping="Wrap"
                               />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind CategoryName}" VerticalAlignment="Center"
                           Style="{StaticResource TechStoreBodyTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="{x:Bind SellingPrice, Converter={StaticResource CurrencyConverter}}"
                           VerticalAlignment="Center" Style="{StaticResource TechStoreBodyTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="3" Text="{x:Bind Sku}" VerticalAlignment="Center"
                           Style="{StaticResource TechStoreSecondaryTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="4" Text="{x:Bind PhysicalQuantity}" VerticalAlignment="Center"
                           Style="{StaticResource TechStoreBodyTextBlockStyle}" TextAlignment="Right"
                           AutomationProperties.Name="Số lượng vật lý" />
                <TextBlock Grid.Column="5" Text="{x:Bind ReservedQuantity}" VerticalAlignment="Center"
                           Style="{StaticResource TechStoreBodyTextBlockStyle}" TextAlignment="Right"
                           AutomationProperties.Name="Số lượng đã giữ" />
                <TextBlock Grid.Column="6" Text="{x:Bind AvailableQuantity}" VerticalAlignment="Center"
                           Style="{StaticResource TechStoreSubheadingTextBlockStyle}" TextAlignment="Right"
                           AutomationProperties.Name="Số lượng có thể bán" />
                <Border Grid.Column="7" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Padding="8,4" CornerRadius="4" Background="{StaticResource TechStoreNeutralBgBrush}"
                        AutomationProperties.Name="{x:Bind StatusLabel}">
                    <TextBlock Text="{x:Bind StatusLabel}" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                </Border>
                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Điều chỉnh"
                            Command="{Binding DataContext.OpenAdjustmentCommand, ElementName=StockListRoot}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TechStoreSecondaryButtonStyle}"
                            AutomationProperties.Name="Điều chỉnh số tồn của dòng sản phẩm này" />
                    <Button Content="Chi tiết"
                            Command="{Binding DataContext.OpenDetailsCommand, ElementName=StockListRoot}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TechStoreSecondaryButtonStyle}"
                            AutomationProperties.Name="Xem chi tiết tồn kho" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Tìm tên sản phẩm hoặc SKU"
                     Style="{StaticResource TechStoreTextBoxStyle}"
                     AutomationProperties.Name="Tìm tồn kho theo tên sản phẩm hoặc SKU" />
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding CategoryOptions}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay}"
                          AutomationProperties.Name="Lọc tồn kho theo danh mục" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          AutomationProperties.Name="Lọc tồn kho theo trạng thái">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=., Converter={StaticResource StockStatusLabelConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Danh sách tồn kho" Style="{StaticResource TechStoreSubheadingTextBlockStyle}" />
            <TextBlock Text="Dữ liệu mẫu · Preview" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsPreviewData, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        Visibility="{Binding HasCategoryError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding CategoryErrorMessage}" Style="{StaticResource TechStoreErrorCaptionTextBlockStyle}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Content="Thử lại danh mục" Command="{Binding RetryCategoriesCommand}"
                        Style="{StaticResource TechStoreSecondaryButtonStyle}"
                        AutomationProperties.Name="Thử tải lại danh mục lọc" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressRing IsActive="True" />
                <TextBlock Text="Đang tải tồn kho…" Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TechStoreErrorCaptionTextBlockStyle}"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="Thử lại" Command="{Binding RetryCommand}"
                        Style="{StaticResource TechStoreSecondaryButtonStyle}"
                        AutomationProperties.Name="Thử tải lại danh sách tồn kho" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <SymbolIcon Symbol="Find" Foreground="{StaticResource TechStoreTextMutedBrush}" />
                <TextBlock Text="Không tìm thấy tồn kho phù hợp." Style="{StaticResource TechStoreSecondaryTextBlockStyle}" />
            </StackPanel>
            <Border Style="{StaticResource TechStoreCardBorderStyle}" Padding="0"
                    Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                              AutomationProperties.Name="Bảng danh sách tồn kho">
                    <Grid MinWidth="1120">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="14" Padding="12,10" Background="{StaticResource TechStoreNeutralBgBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sản phẩm / biến thể" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Danh mục" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="Giá bán" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="SKU biến thể" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Grid.Column="4" Text="Vật lý" Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Đã giữ" Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="Có thể bán" Style="{StaticResource TechStoreCaptionTextBlockStyle}" TextAlignment="Right" />
                            <TextBlock Grid.Column="7" Text="Trạng thái" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                            <TextBlock Grid.Column="8" Text="Thao tác" Style="{StaticResource TechStoreCaptionTextBlockStyle}" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource StockBalanceTemplate}" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="8">
            <TextBlock Text="{Binding PaginationLabel}" Style="{StaticResource TechStoreMicroCaptionTextBlockStyle}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Trước" Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource TechStoreSecondaryButtonStyle}"
                        AutomationProperties.Name="Trang tồn kho trước" />
                <Button Content="Sau" Command="{Binding NextPageCommand}"
                        Style="{StaticResource TechStoreSecondaryButtonStyle}"
                        AutomationProperties.Name="Trang tồn kho sau" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
