<Page x:Class="TechStore.Client.Views.Development.ComponentGalleryPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="using:TechStore.Client.Controls"
 xmlns:vm="using:TechStore.Client.ViewModels.Development"
 xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
 Background="{ThemeResource TechStoreCanvasBrush}"
 FontFamily="{StaticResource TechStoreRegularFont}">
<Grid x:Name="GalleryRoot" Padding="24" RowSpacing="16" SizeChanged="OnGallerySizeChanged">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Style="{StaticResource TechStorePanelStyle}">
<Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Spacing="4">
<TextBlock Text="TechStore / Hệ thống giao diện" Style="{StaticResource TechStoreHeadingTextStyle}" />
<TextBlock Text="Thư viện giao diện — dữ liệu minh họa" Style="{StaticResource TechStoreCaptionTextStyle}" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
</StackPanel>
<ComboBox Grid.Column="1" Header="Giao diện" ItemsSource="{x:Bind ViewModel.Themes}" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="160" Style="{StaticResource TechStoreComboBoxStyle}" AutomationProperties.AutomationId="ThemeSelector" />
</Grid></Border>
<ScrollViewer x:Name="GalleryScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
<StackPanel Spacing="16" Padding="0,0,12,12">
<TextBlock Text="01 / Tổng quan chỉ số" Style="{StaticResource TechStoreSectionTextStyle}" />
<Grid x:Name="MetricGrid" ColumnSpacing="16" RowSpacing="16">
<Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
<c:StatCard x:Name="RevenueCard" Title="Tổng doanh thu" ValueText="{x:Bind ViewModel.MetricValue, Mode=OneWay}" UnitText="₫" TrendText="+12,5%" DetailText="{x:Bind ViewModel.MetricDetail, Mode=OneWay}" Tone="Success" IconSource="{StaticResource TechStoreMoneyIcon}" IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" ErrorText="{x:Bind ViewModel.MetricError, Mode=OneWay}" />
<c:StatCard x:Name="OrdersCard" Title="Số đơn hàng" ValueText="128" UnitText="đơn" TrendText="+8,2%" DetailText="Trong tuần này" Tone="Success" IconSource="{StaticResource TechStoreBagIcon}" />
<c:StatCard x:Name="ProductsCard" Title="Tổng sản phẩm" ValueText="1.420" UnitText="máy" DetailText="38 danh mục đang hoạt động" IconSource="{StaticResource TechStoreBoxIcon}" />
<c:StatCard x:Name="WarningsCard" Title="Cảnh báo tồn kho" ValueText="7" UnitText="sản phẩm" TrendText="Cần kiểm tra" Tone="Danger" DetailText="Dưới mức tồn an toàn" IconSource="{StaticResource TechStoreWarningIcon}" />
</Grid>
<StackPanel Orientation="Horizontal" Spacing="8">
<Button Content="Nội dung" Command="{x:Bind ViewModel.ShowContentCommand}" Style="{StaticResource TechStoreButtonStyle}" />
<Button Content="Đang tải" Command="{x:Bind ViewModel.ShowLoadingCommand}" Style="{StaticResource TechStoreButtonStyle}" />
<Button Content="Lỗi mẫu" Command="{x:Bind ViewModel.ShowErrorCommand}" Style="{StaticResource TechStoreButtonStyle}" />
</StackPanel>
<Grid x:Name="SpecimenGrid" ColumnSpacing="16" RowSpacing="16">
<Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<Border Style="{StaticResource TechStorePanelStyle}"><StackPanel Spacing="12">
<TextBlock Text="02 / Tìm kiếm &amp; hành động" Style="{StaticResource TechStoreSectionTextStyle}" />
<c:SearchBoxControl Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" SearchCommand="{x:Bind ViewModel.SearchCommand}" ClearCommand="{x:Bind ViewModel.ClearSearchCommand}" />
<TextBlock Text="{x:Bind ViewModel.SearchText, Mode=OneWay}" Style="{StaticResource TechStoreBodyTextStyle}" AutomationProperties.Name="Nội dung đang nhập" />
<TextBlock Text="{x:Bind ViewModel.LastQuery, Mode=OneWay}" Style="{StaticResource TechStoreBodyTextStyle}" AutomationProperties.Name="Tìm kiếm đã gửi" />
<StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Số lần gửi:" Style="{StaticResource TechStoreCaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.SubmitCount, Mode=OneWay}" Style="{StaticResource TechStoreMonoTextStyle}" /></StackPanel>
<CheckBox Content="Cho phép gửi tìm kiếm" IsChecked="{x:Bind ViewModel.CanSearch, Mode=TwoWay}" />
<c:SearchBoxControl Label="Tìm kiếm bị vô hiệu hóa" Text="Không thể chỉnh sửa" IsEnabled="False" />
<StackPanel Orientation="Horizontal" Spacing="8">
<Button Content="Tạo mới" Style="{StaticResource TechStorePrimaryButtonStyle}" Command="{x:Bind ViewModel.EmptyActionCommand}" />
<Button Content="Bộ lọc" Style="{StaticResource TechStoreButtonStyle}" />
<Button Content="Đã khóa" Style="{StaticResource TechStoreButtonStyle}" IsEnabled="False" />
</StackPanel>
</StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource TechStorePanelStyle}"><StackPanel Spacing="12">
<TextBlock Text="03 / Biểu mẫu &amp; validation" Style="{StaticResource TechStoreSectionTextStyle}" />
<TextBox Header="Số điện thoại (minh họa)" Text="{x:Bind ViewModel.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TechStoreTextBoxStyle}" AutomationProperties.HelpText="{x:Bind ViewModel.PhoneError, Mode=OneWay}" />
<TextBlock Text="{x:Bind ViewModel.PhoneError, Mode=OneWay}" Style="{StaticResource TechStoreFieldErrorStyle}" AutomationProperties.LiveSetting="Polite" />
<Button Content="Kiểm tra" Command="{x:Bind ViewModel.ValidatePhoneCommand}" Style="{StaticResource TechStorePrimaryButtonStyle}" />
<TextBox Header="Giá trị KPI có thể thay đổi" Text="{x:Bind ViewModel.MetricValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TechStoreTextBoxStyle}" />
<TextBox Header="Ghi chú KPI (có thể xóa)" Text="{x:Bind ViewModel.MetricDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TechStoreTextBoxStyle}" />
</StackPanel></Border>
<Border Grid.Row="1" Style="{StaticResource TechStorePanelStyle}"><StackPanel Spacing="12">
<TextBlock Text="04 / Trạng thái &amp; phản hồi" Style="{StaticResource TechStoreSectionTextStyle}" />
<StackPanel Orientation="Horizontal" Spacing="8"><c:StatusBadge Label="Hoàn thành" Tone="Success"/><c:StatusBadge Label="Chờ thanh toán" Tone="Warning"/></StackPanel>
<StackPanel Orientation="Horizontal" Spacing="8"><c:StatusBadge Label="Đã hủy" Tone="Danger"/><c:StatusBadge Label="Đang xử lý" Tone="Info"/><c:StatusBadge Label="Đã bán" Tone="Neutral"/></StackPanel>
<c:StatusBadge Label="{x:Bind ViewModel.BadgeLabel, Mode=OneWay}" Tone="Accent" />
<TextBox Header="Nhãn trạng thái (xóa để ẩn badge)" Text="{x:Bind ViewModel.BadgeLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TechStoreTextBoxStyle}" />
<InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Dữ liệu minh họa" Message="Không có kết nối API trong thư viện giao diện." />
</StackPanel></Border>
<Border Grid.Row="1" Grid.Column="1" Style="{StaticResource TechStorePanelStyle}"><StackPanel Spacing="12">
<TextBlock Text="05 / Trạng thái rỗng" Style="{StaticResource TechStoreSectionTextStyle}" />
<c:EmptyStateControl Title="Không tìm thấy dữ liệu" Description="Hãy thử từ khóa khác hoặc đặt lại bộ lọc." ActionText="Đặt lại bộ lọc" ActionCommand="{x:Bind ViewModel.EmptyActionCommand}" IconSource="{StaticResource TechStoreBoxIcon}" />
<CheckBox Content="Cho phép hành động" IsChecked="{x:Bind ViewModel.CanAct, Mode=TwoWay}" />
<StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Số lần thực hiện:" Style="{StaticResource TechStoreCaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.ActionCount, Mode=OneWay}" Style="{StaticResource TechStoreMonoTextStyle}" /></StackPanel>
</StackPanel></Border>
<Border Grid.Row="2" Style="{StaticResource TechStorePanelStyle}"><StackPanel Spacing="12">
<TextBlock Text="06 / Kiểu chữ &amp; dữ liệu" Style="{StaticResource TechStoreSectionTextStyle}" />
<TextBlock Text="Tổng quan doanh thu TechStore" Style="{StaticResource TechStoreHeadingTextStyle}" />
<TextBlock Text="Nguyễn Thị Mỹ — Điện thoại &amp; phụ kiện" Style="{StaticResource TechStoreBodyTextStyle}" />
<TextBlock Text="Ắ ằ ễ ộ ự ỹ • Đang sửa chữa • 34.990.000 ₫" Style="{StaticResource TechStoreBodyTextStyle}" />
<TextBlock Text="IMEI: 352910482910481" Style="{StaticResource TechStoreMonoTextStyle}" />
<StackPanel Orientation="Horizontal" Spacing="20"><IconSourceElement IconSource="{StaticResource TechStoreMoneyIcon}"/><IconSourceElement IconSource="{StaticResource TechStoreBoxIcon}"/><IconSourceElement IconSource="{StaticResource TechStoreWarningIcon}"/></StackPanel>
</StackPanel></Border>
<Border Grid.Row="2" Grid.Column="1" Style="{StaticResource TechStorePanelStyle}"><StackPanel Spacing="12">
<TextBlock Text="07 / Màu sắc &amp; Toolkit" Style="{StaticResource TechStoreSectionTextStyle}" />
<Grid Height="40" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="{ThemeResource TechStorePrimaryBrush}" CornerRadius="4"/><Border Grid.Column="1" Background="{ThemeResource TechStoreSuccessTextBrush}" CornerRadius="4"/><Border Grid.Column="2" Background="{ThemeResource TechStoreWarningTextBrush}" CornerRadius="4"/><Border Grid.Column="3" Background="{ThemeResource TechStoreDangerTextBrush}" CornerRadius="4"/>
</Grid>
<toolkit:SettingsCard Header="Gửi tìm kiếm" Description="Kiểm tra command và trạng thái enabled."><ToggleSwitch IsOn="{x:Bind ViewModel.CanSearch, Mode=TwoWay}" AutomationProperties.Name="Cho phép gửi tìm kiếm" /></toolkit:SettingsCard>
<toolkit:SettingsExpander Header="Thông tin preview" Description="Windows Community Toolkit"><TextBlock Text="SettingsControls 8.2.250402 — bản ứng viên kiểm thử." Style="{StaticResource TechStoreBodyTextStyle}" /></toolkit:SettingsExpander>
</StackPanel></Border>
</Grid>
<Border Style="{StaticResource TechStorePanelStyle}">
<Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="08 / Bảng dữ liệu minh họa" Style="{StaticResource TechStoreSectionTextStyle}" />
<ListView Grid.Row="1" Height="176" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" ItemContainerStyle="{StaticResource TechStoreTableRowStyle}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled">
<ListView.Header><Grid MinWidth="960" Padding="12,4" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
<TextBlock Text="MÃ ĐƠN" Style="{StaticResource TechStoreTableHeaderStyle}"/><TextBlock Grid.Column="1" Text="KHÁCH HÀNG" Style="{StaticResource TechStoreTableHeaderStyle}"/><TextBlock Grid.Column="2" Text="SẢN PHẨM" Style="{StaticResource TechStoreTableHeaderStyle}"/><TextBlock Grid.Column="3" Text="TỔNG TIỀN" HorizontalAlignment="Right" Style="{StaticResource TechStoreTableHeaderStyle}"/>
</Grid></ListView.Header>
<ListView.ItemTemplate><DataTemplate x:DataType="vm:GalleryRow"><Grid MinWidth="936" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
<TextBlock Text="{x:Bind Code}" Style="{StaticResource TechStoreBodyTextStyle}" Foreground="{ThemeResource TechStoreInfoTextBrush}"/><TextBlock Grid.Column="1" Text="{x:Bind Customer}" Style="{StaticResource TechStoreBodyTextStyle}"/><TextBlock Grid.Column="2" Text="{x:Bind Product}" Style="{StaticResource TechStoreBodyTextStyle}"/><TextBlock Grid.Column="3" Text="{x:Bind Amount}" HorizontalAlignment="Right" Style="{StaticResource TechStoreMonoTextStyle}"/>
</Grid></DataTemplate></ListView.ItemTemplate></ListView>
</Grid></Border>
<Border Style="{StaticResource TechStorePanelStyle}">
<StackPanel Spacing="12">
<TextBlock Text="09 / Diagnostics · DEVELOPMENT" Style="{StaticResource TechStoreSectionTextStyle}" />
<TextBlock Text="Các nút này kiểm tra lifecycle và dialog; không gọi API hoặc thay đổi dữ liệu." Style="{StaticResource TechStoreBodyTextStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
<StackPanel Orientation="Horizontal" Spacing="8">
<Button Content="Tải chờ hủy" Command="{x:Bind DiagnosticViewModel.StartPendingLoadCommand}" Style="{StaticResource TechStoreButtonStyle}" />
<Button Content="Mô phỏng lỗi" Command="{x:Bind DiagnosticViewModel.SimulateLoadFailureCommand}" Style="{StaticResource TechStoreButtonStyle}" />
<Button x:Name="DiagnosticFocusButton" Content="Thử hộp thoại" Command="{x:Bind DiagnosticViewModel.ShowConfirmDialogCommand}" Style="{StaticResource TechStorePrimaryButtonStyle}" />
<Button Content="Thử lại" Command="{x:Bind DiagnosticViewModel.RetryCommand}" Style="{StaticResource TechStoreButtonStyle}" />
</StackPanel>
<TextBlock Text="{x:Bind DiagnosticViewModel.ContentStateDescription, Mode=OneWay}" Style="{StaticResource TechStoreCaptionTextStyle}" />
<TextBlock Text="{x:Bind DiagnosticViewModel.DiagnosticStatus, Mode=OneWay}" Style="{StaticResource TechStoreBodyTextStyle}" TextWrapping="Wrap" />
<TextBlock Text="{x:Bind DiagnosticViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource TechStoreFieldErrorStyle}" />
</StackPanel>
</Border>
</StackPanel></ScrollViewer>
</Grid></Page>
