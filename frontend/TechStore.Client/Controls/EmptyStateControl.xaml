<UserControl x:Class="TechStore.Client.Controls.EmptyStateControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsTabStop="False">
<Border Style="{StaticResource TechStorePanelStyle}" Background="{ThemeResource TechStoreCanvasBrush}">
<StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
<IconSourceElement x:Name="EmptyIcon" IconSource="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Center" />
<TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TechStoreSectionTextStyle}" TextAlignment="Center" />
<TextBlock x:Name="DescriptionLabel" Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource TechStoreBodyTextStyle}" TextAlignment="Center" Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
<Button x:Name="ActionButton" Content="{x:Bind ActionText, Mode=OneWay}" Command="{x:Bind ActionCommand, Mode=OneWay}" Style="{StaticResource TechStoreButtonStyle}" HorizontalAlignment="Center" />
</StackPanel></Border></UserControl>