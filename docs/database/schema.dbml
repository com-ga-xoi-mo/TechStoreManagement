// ============================================================================
// TECHSTORE MANAGEMENT SYSTEM - POSTGRESQL DATABASE SCHEMA (DBML)
// ============================================================================
// Platform: PostgreSQL 16+ / Supabase
// Architecture: Modular Monolith (3-Tier API-First POS & Inventory Platform)
// Tool: Designed for direct visualization on dbdiagram.io & dbdocs.io
//
// SUPABASE POSTGRES BEST PRACTICES APPLIED:
// 1. 100% Foreign Key Indexing: Every FK column has an explicit B-tree index
//    to prevent sequential scans and avoid table locks during cascade checks.
// 2. Composite Foreign Keys: Enforce (variant_id, product_id) references to
//    guarantee a variant strictly belongs to its parent product.
// 3. JSONB Hardware Specs Indexing: GIN index with jsonb_path_ops for fast
//    hardware containment queries (specs @> '{"ram": "16GB"}').
// 4. Strict Data Types: timestamptz (UTC) for temporal fields and numeric(18, 2)
//    for all financial amounts.
// 5. Concurrency & Anti-Overselling: Database check constraints (stock >= 0,
//    reserved <= quantity) and row-level locking (SELECT ... FOR UPDATE).
// 6. Identifier Consistency: Lowercase snake_case identifiers throughout.
// ============================================================================

// ============================================================================
// 1. DOMAIN ENUMS
// ============================================================================

Enum order_status {
  Pending     [note: 'Order created, awaiting cashier or payment processing']
  Processing  [note: 'Payment received, order items being picked/packaged']
  Completed   [note: 'Order successfully settled and fulfilled']
  Cancelled   [note: 'Order cancelled before settlement']
  Refunded    [note: 'Order returned and payment refunded']
}

Enum payment_method {
  Cash    [note: 'Physical cash received at POS counter register']
  VietQr  [note: 'Dynamic VietQR banking transfer payment']
  Card    [note: 'Debit/Credit card terminal payment']
}

Enum serial_imei_status {
  InStock       [note: 'Device is physically present in warehouse/counter stock']
  Reserved      [note: 'Device is locked for a pending POS order, awaiting payment confirmation. Prevents double-selling.']
  Sold          [note: 'Device has been sold and linked to an OrderItem']
  Returned      [note: 'Device returned by customer, pending inspection before restock or defective classification']
  UnderRepair   [note: 'Sold device checked in for repair; return to Sold when handed back to the customer']
  Defective     [note: 'Device marked defective/RMA awaiting supplier return']
}

Enum inventory_movement_type {
  OpeningBalance  [note: 'Initial stock recorded when the system starts tracking an item']
  PurchaseReceipt [note: 'Stock received from a supplier purchase order (+)']
  Sale            [note: 'Stock deducted for a completed sale (-)']
  CustomerReturn  [note: 'Inspected customer return added back to sellable stock (+)']
  Adjustment      [note: 'Manual correction after stocktaking or loss (+/-)']
  Defective       [note: 'Damaged or defective stock written off (-)']
}

Enum customer_tier {
  Standard  [note: 'Default tier (0 - 499 loyalty points)']
  Silver    [note: 'Silver tier (500 - 1,499 loyalty points, 2% discount)']
  Gold      [note: 'Gold tier (1,500 - 4,999 loyalty points, 5% discount)']
  Platinum  [note: 'VIP Platinum tier (5,000+ points, 10% discount)']
}

Enum voucher_type {
  Percentage   [note: 'Discount percentage (e.g., 10% off)']
  FixedAmount  [note: 'Direct monetary discount amount (e.g., 200,000 VND)']
}

Enum purchase_order_status {
  Draft              [note: 'Procurement order being prepared']
  Ordered            [note: 'Order placed with supplier']
  PartiallyReceived  [note: 'Some lines received, others still outstanding. Allows partial fulfillment shipments.']
  Received           [note: 'All goods fully received and stock incremented']
  Cancelled          [note: 'Procurement order cancelled']
}

Enum pos_session_status {
  Open    [note: 'Cashier shift is currently active']
  Closed  [note: 'Shift closed, cash reconciled']
}

Enum vietqr_status {
  Pending    [note: 'VietQR dynamic code generated, awaiting bank webhook']
  Confirmed  [note: 'Bank transfer confirmed, payment settled']
  Failed     [note: 'Transaction failed or rejected']
  Expired    [note: 'Payment QR expired (timeout reached)']
}

Enum role_type {
  Admin           [note: 'Full system administration, settings, user management']
  Manager         [note: 'Store manager, revenue reports, analytics, audit']
  SalesStaff      [note: 'POS cashier, customer orders, lookup in-stock devices']
  WarehouseStaff  [note: 'Inventory intake, supplier POs, serial/IMEI management']
}

// ============================================================================
// 2. CATALOG MODULE
// ============================================================================

// Catalog business rules (cross-row rules are documented here, not enforced by CHECK):
// - A product without variants is bought/sold directly with variant_id = NULL.
//   Once variants exist, new stock/order lines must select a variant, even if all
//   variants are inactive. Reconcile existing product-level stock before this transition.
// - Products with variants use their SKU as a model lookup code and have no barcode;
//   each sellable variant owns its SKU, optional barcode and selling price.
// - SKU and non-null barcode values must be unique across BOTH Catalog tables.
//   The indexes below enforce uniqueness within each table only; cross-table
//   uniqueness requires serialized validation or database triggers on writes.
// - Specs are flat JSON objects with lowercase snake_case keys and consistent units:
//   cpu: string, ram_gb: number, storage_gb: number, battery_mah: number, color: string.
//   New keys are allowed. JSON null values are not part of the specs contract.
//   Effective specs = product.specs || variant.specs (variant wins per top-level key).
//   An absent variant key inherits the product value; filtering uses effective specs.
// - Selling requires an active product and, when selected, an active variant.
//   Use is_active to retire records; hard deletion is only for unused records.
// - Category parent changes must reject ancestor cycles atomically; the CHECK
//   below rejects direct self-parenting only.

Table categories {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  name text [not null, note: 'Category name (e.g., Smartphones, Laptops, Accessories)']
  slug text [not null, note: 'URL-friendly unique slug; lowercase and trimmed']
  description text [null, note: 'Detailed description of product category']
  parent_id uuid [null, note: 'Self-referencing FK for sub-categories; backend must reject self-parenting and ancestor cycles']
  is_active boolean [not null, default: true, note: 'Soft status flag']
  created_at timestamptz [not null, default: `now()`, note: 'UTC creation timestamp']
  updated_at timestamptz [null, note: 'UTC last update timestamp']

  indexes {
    parent_id [name: 'idx_categories_parent_id', note: 'FK index: prevents table lock on cascade']
    slug [unique, name: 'idx_categories_slug']
  }

  checks {
    `BTRIM(name) <> ''` [name: 'chk_categories_name_not_blank']
    `slug <> '' AND slug = LOWER(BTRIM(slug))` [name: 'chk_categories_slug_normalized']
    `parent_id IS NULL OR parent_id <> id` [name: 'chk_categories_not_self_parent']
  }

  Note: 'Product taxonomy hierarchy supporting nested categories'
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  category_id uuid [not null, note: 'FK -> categories.id']
  name text [not null, note: 'Product commercial name (e.g., iPhone 15 Pro Max)']
  sku text [not null, note: 'Uppercase trimmed code; direct-sale SKU without variants, model lookup code otherwise']
  barcode text [null, note: 'Unique retail barcode for a product without variants; NULL when variants exist; preserve leading zeros']
  brand text [not null, note: 'Manufacturer brand (Apple, Asus, Dell, Samsung)']
  base_price numeric(18,2) [not null, note: 'Direct-sale price without variants; reference price otherwise. Variant sales use product_variants.price (VND)']
  cost_price numeric(18,2) [not null, note: 'Standard reference procurement cost; actual receipt costs belong to purchase_order_items.unit_cost']
  description text [null, note: 'Marketing overview and specifications summary']
  image_url text [null, note: 'CDN image URL']
  specs jsonb [not null, default: `'{}'::jsonb`, note: 'Shared hardware specs object; see Catalog key, type and inheritance rules']
  is_serial_tracked boolean [not null, default: true, note: 'True if every device unit has unique Serial/IMEI']
  is_active boolean [not null, default: true, note: 'Active in catalog']
  created_at timestamptz [not null, default: `now()`, note: 'UTC creation timestamp']
  updated_at timestamptz [null, note: 'UTC last update timestamp']

  indexes {
    category_id [name: 'idx_products_category_id', note: 'FK index: accelerates category filtering']
    sku [unique, name: 'idx_products_sku']
    barcode [unique, name: 'idx_products_barcode', note: 'Unique non-null barcode within products; cross-table uniqueness follows Catalog rules']
    specs [type: gin, name: 'idx_products_specs_gin', note: 'GIN with jsonb_path_ops for @> queries; configure operator class explicitly in PostgreSQL']
  }

  checks {
    `BTRIM(name) <> ''` [name: 'chk_products_name_not_blank']
    `BTRIM(brand) <> ''` [name: 'chk_products_brand_not_blank']
    `sku <> '' AND sku = UPPER(BTRIM(sku))` [name: 'chk_products_sku_normalized']
    `barcode IS NULL OR (barcode <> '' AND barcode = BTRIM(barcode))` [name: 'chk_products_barcode_not_blank']
    `base_price >= 0` [name: 'chk_products_base_price_non_negative']
    `cost_price >= 0` [name: 'chk_products_cost_price_non_negative']
    `jsonb_typeof(specs) = 'object'` [name: 'chk_products_specs_object']
  }

  Note: 'Core hardware catalog with dynamic specifications stored in JSONB'
}

Table product_variants {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  product_id uuid [not null, note: 'FK -> products.id']
  variant_name text [not null, note: 'Variant descriptor (e.g., Space Black 256GB)']
  sku text [not null, note: 'Uppercase trimmed sellable SKU; follows cross-table uniqueness rules']
  barcode text [null, note: 'Unique retail barcode identifying this exact variant; preserve leading zeros']
  price numeric(18,2) [not null, note: 'Selling price for this exact variant (VND)']
  specs jsonb [not null, default: `'{}'::jsonb`, note: 'Top-level overrides of product specs; absent keys inherit; JSON null values are disallowed by the Catalog contract']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    product_id [name: 'idx_product_variants_product_id', note: 'FK index: fast product variant retrieval']
    sku [unique, name: 'idx_product_variants_sku']
    barcode [unique, name: 'idx_product_variants_barcode', note: 'Unique non-null barcode within variants; cross-table uniqueness follows Catalog rules']
    specs [type: gin, name: 'idx_product_variants_specs_gin', note: 'GIN with jsonb_path_ops for @> queries; configure operator class explicitly in PostgreSQL']
    (id, product_id) [unique, name: 'uq_product_variants_id_product', note: 'Referenced by composite FKs to ensure the variant belongs to the selected product']
  }

  checks {
    `BTRIM(variant_name) <> ''` [name: 'chk_product_variants_name_not_blank']
    `sku <> '' AND sku = UPPER(BTRIM(sku))` [name: 'chk_product_variants_sku_normalized']
    `barcode IS NULL OR (barcode <> '' AND barcode = BTRIM(barcode))` [name: 'chk_product_variants_barcode_not_blank']
    `price >= 0` [name: 'chk_product_variants_price_non_negative']
    `jsonb_typeof(specs) = 'object'` [name: 'chk_product_variants_specs_object']
  }

  Note: 'SKU variants for hardware options (Storage capacity, colorways)'
}

// ============================================================================
// 3. INVENTORY MODULE
// ============================================================================

Table inventory_stocks {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  product_id uuid [not null, note: 'FK -> products.id']
  variant_id uuid [null, note: 'FK -> product_variants.id (NULL for standalone products without variants)']
  quantity integer [not null, default: 0, note: 'CHECK quantity >= 0: Physical units available in stock']
  reserved_quantity integer [not null, default: 0, note: 'CHECK reserved_quantity >= 0 AND reserved_quantity <= quantity: Units locked in pending checkout. Upper bound prevents overselling.']
  min_stock_alert integer [not null, default: 5, note: 'CHECK min_stock_alert >= 0: Low stock warning threshold']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    variant_id [name: 'idx_inventory_stocks_variant_id', note: 'FK index']
    // PostgreSQL 16 migration must create this as UNIQUE NULLS NOT DISTINCT (product_id, variant_id).
    (product_id, variant_id) [unique, name: 'idx_inventory_stocks_product_variant', note: 'PostgreSQL 16: UNIQUE NULLS NOT DISTINCT (product_id, variant_id) ensures only 1 balance row even when variant_id is NULL. Leading column product_id covers single-column lookups.']
  }

  // Quy ước nghiệp vụ cho Dev 4 và Dev 6:
  // 1. Sản phẩm đã có variant thì KHÔNG ĐƯỢC có dòng tồn kho NULL variant_id (phải có unit test chặn).
  // 2. Với máy serial-tracked (is_serial_tracked = true): quantity = COUNT(serial_imeis WHERE status IN ('InStock', 'Reserved')).
  Note: '''
  Current sellable physical stock before reservations; available to sell = quantity - reserved_quantity. Update with serial status and inventory_movements in one transaction using FOR UPDATE.
  UNIQUE CONSTRAINT:
    PostgreSQL 16 UNIQUE NULLS NOT DISTINCT on (product_id, variant_id).
    EF Core 10: builder.HasIndex(x => new { x.ProductId, x.VariantId }).IsUnique().AreNullsDistinct(false);
  CHECK CONSTRAINTS (enforced via EF Core HasCheckConstraint):
    ck_inventory_stocks_quantity_ge_zero      : (quantity >= 0)
    ck_inventory_stocks_reserved_ge_zero      : (reserved_quantity >= 0)
    ck_inventory_stocks_reserved_le_quantity  : (reserved_quantity <= quantity)
  '''
}

Table inventory_movements {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  inventory_stock_id uuid [not null, note: 'FK -> inventory_stocks.id: product and optional variant whose stock changed']
  movement_type inventory_movement_type [not null, note: 'Business reason for the stock change']
  quantity_change integer [not null, note: 'CHECK quantity_change <> 0: Signed change to quantity; positive for intake (+), negative for sale or loss (-)']
  quantity_after integer [not null, note: 'CHECK quantity_after >= 0: Stock quantity immediately after this change']
  performed_by_user_id uuid [not null, note: 'FK -> users.id: person who performed or confirmed the operation']
  purchase_order_item_id uuid [null, note: 'FK -> purchase_order_items.id: source line for a purchase receipt']
  order_item_id uuid [null, note: 'FK -> order_items.id: source line for a sale']
  order_return_id uuid [null, note: 'FK -> order_returns.id: source return when an item is restocked']
  reason text [null, note: 'Required by backend for a manual adjustment or loss write-off']
  created_at timestamptz [not null, default: `now()`, note: 'UTC time of the stock change']
  updated_at timestamptz [null, note: 'Movement history is append-only; corrections require a new movement']

  indexes {
    (inventory_stock_id, created_at) [name: 'idx_inventory_movements_stock_created_at', note: 'FK index and chronological stock history by product/variant']
    performed_by_user_id [name: 'idx_inventory_movements_user_id', note: 'FK index']
    purchase_order_item_id [name: 'idx_inventory_movements_po_item_id', note: 'FK index']
    order_item_id [name: 'idx_inventory_movements_order_item_id', note: 'FK index']
    order_return_id [name: 'idx_inventory_movements_return_id', note: 'FK index']
  }

  Note: '''
  Append-only stock ledger. Insert together with the inventory balance change in one transaction; reservations alone do not create a movement.
  CHECK CONSTRAINTS (enforced via EF Core HasCheckConstraint):
    ck_inventory_movements_qty_change_not_zero : (quantity_change <> 0)
    ck_inventory_movements_qty_after_ge_zero   : (quantity_after >= 0)
  '''
}

Table suppliers {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  name text [not null, note: 'Supplier / Distributor company name']
  contact_name text [null, note: 'Representative contact person']
  phone text [not null, note: 'Business telephone number']
  email text [null, note: 'Contact email address']
  address text [null, note: 'Headquarters / warehouse address']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    phone [name: 'idx_suppliers_phone']
  }

  Note: 'Authorized hardware distributors and component vendors'
}

Table purchase_orders {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  supplier_id uuid [not null, note: 'FK -> suppliers.id']
  created_by_user_id uuid [not null, note: 'FK -> users.id: Warehouse staff or Admin who created PO']
  received_by_user_id uuid [null, note: 'FK -> users.id: staff member who confirmed receipt (NULL until goods arrive)']
  po_number text [not null, unique, note: 'Purchase Order reference code (e.g., PO-202610-001)']
  status purchase_order_status [not null, default: 'Draft']
  total_cost "numeric(18, 2)" [not null, default: 0, note: 'CHECK total_cost >= 0: Total procurement value']
  notes text [null, note: 'Special delivery terms or shipment notes']
  ordered_at timestamptz [null, note: 'Order submission timestamp']
  received_at timestamptz [null, note: 'Warehouse intake timestamp when status becomes PartiallyReceived or Received']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    supplier_id [name: 'idx_purchase_orders_supplier_id', note: 'FK index']
    created_by_user_id [name: 'idx_purchase_orders_created_by', note: 'FK index']
    received_by_user_id [name: 'idx_purchase_orders_received_by', note: 'FK index']
    po_number [unique, name: 'idx_purchase_orders_po_number']
    status [name: 'idx_purchase_orders_status']
  }

  Note: 'Inbound procurement orders from authorized hardware suppliers. Allows partial shipments via PartiallyReceived status.'
}

Table purchase_order_items {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  purchase_order_id uuid [not null, note: 'FK -> purchase_orders.id']
  product_id uuid [not null, note: 'FK -> products.id']
  variant_id uuid [null, note: 'FK -> product_variants.id (NULL for standalone products)']
  ordered_quantity integer [not null, note: 'CHECK ordered_quantity > 0']
  received_quantity integer [not null, default: 0, note: 'CHECK received_quantity >= 0 AND received_quantity <= ordered_quantity: Prevents intake typo']
  unit_cost "numeric(18, 2)" [not null, note: 'CHECK unit_cost >= 0: Purchase price per unit']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    purchase_order_id [name: 'idx_po_items_po_id', note: 'FK index: fast PO line items lookup']
    product_id [name: 'idx_po_items_product_id', note: 'FK index']
    variant_id [name: 'idx_po_items_variant_id', note: 'FK index']
    // PostgreSQL 16 migration must create this as UNIQUE NULLS NOT DISTINCT (purchase_order_id, product_id, variant_id).
    (purchase_order_id, product_id, variant_id) [unique, name: 'uq_po_items_order_product_variant', note: 'One line and one unit cost per product/variant on each purchase order, including NULL variant_id']
  }

  Note: '''
  Line items within an inbound procurement order.
  CHECK CONSTRAINTS (enforced via EF Core HasCheckConstraint):
    ck_po_items_ordered_qty_gt_zero : (ordered_quantity > 0)
    ck_po_items_received_qty_valid  : (received_quantity >= 0 AND received_quantity <= ordered_quantity)
    ck_po_items_unit_cost_ge_zero   : (unit_cost >= 0)
  '''
}

Table serial_imeis {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  product_id uuid [not null, note: 'FK -> products.id']
  variant_id uuid [null, note: 'FK -> product_variants.id (NULL for standalone devices)']
  serial_number text [null, note: 'Hardware serial number (MacBook, PC Component)']
  imei text [null, note: 'CHECK: exactly 15 digits (^[0-9]{15}$); NULL for serial-only hardware']
  status serial_imei_status [not null, default: 'InStock', note: 'Device lifecycle state']
  unit_cost "numeric(18, 2)" [null, note: 'CHECK unit_cost >= 0: Landed unit cost copied from PO item for precise margin reporting']
  purchase_order_id uuid [null, note: 'FK -> purchase_orders.id: Procurement origin']
  warranty_months integer [not null, default: 12, note: 'CHECK warranty_months >= 0: Manufacturer warranty period']
  warranty_start_at timestamptz [null, note: 'Activated when the sale is completed']
  warranty_end_at timestamptz [null, note: 'Calculated as start + warranty_months; active while start <= now() < end']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    product_id [name: 'idx_serial_imeis_product_id', note: 'FK index']
    variant_id [name: 'idx_serial_imeis_variant_id', note: 'FK index']
    purchase_order_id [name: 'idx_serial_imeis_po_id', note: 'FK index']
    serial_number [unique, name: 'idx_serial_imeis_serial', note: 'Unique serial constraint where not null']
    imei [unique, name: 'idx_serial_imeis_imei', note: 'Unique IMEI constraint where not null']
    (product_id, status) [name: 'idx_serial_imeis_instock', note: 'Supabase Best Practice: Partial index WHERE status = "InStock" for fast POS scanning']
  }

  checks {
    `NULLIF(BTRIM(serial_number), '') IS NOT NULL OR NULLIF(BTRIM(imei), '') IS NOT NULL` [name: 'ck_serial_imeis_identifier_present']
    `imei IS NULL OR imei ~ '^[0-9]{15}$'` [name: 'ck_serial_imeis_imei_format']
    `unit_cost IS NULL OR unit_cost >= 0` [name: 'ck_serial_imeis_unit_cost']
  }

  Note: 'Only products with is_serial_tracked = true have rows here. A device must have a valid serial number or 15-digit IMEI.'
}

// ============================================================================
// 4. ORDERS MODULE
// ============================================================================

Table orders {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  order_code text [not null, unique, note: 'Customer-facing order code (e.g., ORD-202610-0001)']
  customer_id uuid [null, note: 'FK -> customers.id (null for walk-in retail guest)']
  cashier_user_id uuid [not null, note: 'FK -> users.id: Staff member who processed the sale']
  pos_session_id uuid [null, note: 'FK -> pos_sessions.id: Active counter shift register']
  status order_status [not null, default: 'Pending']
  payment_method payment_method [not null, default: 'Cash']
  subtotal "numeric(18, 2)" [not null, note: 'CHECK subtotal >= 0: Total item prices before discount']
  discount_amount "numeric(18, 2)" [not null, default: 0, note: 'CHECK discount_amount >= 0: Voucher or VIP discount']
  tax_amount "numeric(18, 2)" [not null, default: 0, note: 'CHECK tax_amount >= 0: VAT amount']
  total_amount "numeric(18, 2)" [not null, note: 'CHECK total_amount >= 0: Final payable amount']
  voucher_id uuid [null, note: 'FK -> vouchers.id: Applied coupon discount']
  notes text [null, note: 'Customer requests or cashier notes']
  completed_at timestamptz [null, note: 'Timestamp when payment was settled and warranty activated']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    customer_id [name: 'idx_orders_customer_id', note: 'FK index: fast customer purchase history']
    cashier_user_id [name: 'idx_orders_cashier_id', note: 'FK index']
    pos_session_id [name: 'idx_orders_session_id', note: 'FK index: shift reconciliation']
    voucher_id [name: 'idx_orders_voucher_id', note: 'FK index']
    order_code [unique, name: 'idx_orders_code']
    status [name: 'idx_orders_status', note: 'Accelerates dashboard status filters']
    created_at [name: 'idx_orders_created_at', note: 'Accelerates sales date range reports']
  }

  Note: 'Retail POS and online customer sales orders'
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  order_id uuid [not null, note: 'FK -> orders.id (ON DELETE CASCADE)']
  product_id uuid [not null, note: 'FK -> products.id']
  variant_id uuid [null, note: 'FK -> product_variants.id']
  serial_imei_id uuid [null, note: 'FK -> serial_imeis.id (Allocated device unit)']
  product_name text [not null, note: 'Historical snapshot of product title at purchase']
  unit_price "numeric(18, 2)" [not null, note: 'CHECK unit_price >= 0: Price at purchase moment']
  quantity integer [not null, default: 1, note: 'CHECK quantity > 0: Typically 1 for serial-tracked items']
  discount_amount "numeric(18, 2)" [not null, default: 0, note: 'CHECK discount_amount >= 0']
  total_price "numeric(18, 2)" [not null, note: 'CHECK total_price >= 0: (unit_price * quantity) - discount']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    order_id [name: 'idx_order_items_order_id', note: 'FK index: critical for order retrieval']
    product_id [name: 'idx_order_items_product_id', note: 'FK index']
    variant_id [name: 'idx_order_items_variant_id', note: 'FK index']
    serial_imei_id [name: 'idx_order_items_serial_imei_id', note: 'FK index: device warranty verification']
  }

  Note: 'Individual order lines with linkage to specific sold Serial/IMEI devices'
}

Table order_returns {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  order_id uuid [not null, note: 'FK -> orders.id']
  order_item_id uuid [not null, note: 'FK -> order_items.id']
  processed_by_user_id uuid [not null, note: 'FK -> users.id']
  reason text [not null, note: 'Return/refund justification (Defective, Customer remorse)']
  refund_amount "numeric(18, 2)" [not null, note: 'CHECK refund_amount >= 0']
  is_restocked boolean [not null, default: false, note: 'True if returned item is inspected and put back into inventory']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    order_id [name: 'idx_order_returns_order_id', note: 'FK index']
    order_item_id [name: 'idx_order_returns_item_id', note: 'FK index']
    processed_by_user_id [name: 'idx_order_returns_user_id', note: 'FK index']
  }

  Note: 'Post-purchase returns, device warranties, and cashier refund tracking'
}

// ============================================================================
// 5. CUSTOMERS & SALES MODULE
// ============================================================================

Table customers {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  full_name text [not null, note: 'Customer full name']
  phone text [not null, unique, note: 'Unique phone number for lookup and POS identification']
  email text [null, note: 'Customer contact email']
  address text [null, note: 'Shipping / billing address']
  loyalty_points integer [not null, default: 0, note: 'CHECK loyalty_points >= 0: Accumulated balance']
  tier customer_tier [not null, default: 'Standard', note: 'VIP discount tier']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    phone [unique, name: 'idx_customers_phone', note: 'Fast phone number lookup at POS checkout']
    tier [name: 'idx_customers_tier']
  }

  Note: 'Customer profiles, contact data, and loyalty membership'
}

Table customer_loyalty_points {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  customer_id uuid [not null, note: 'FK -> customers.id (ON DELETE CASCADE)']
  order_id uuid [null, note: 'FK -> orders.id (Order that awarded or spent points)']
  points_change integer [not null, note: 'Positive for accrual (+100), negative for redemption (-50)']
  balance_after integer [not null, note: 'CHECK balance_after >= 0: Running point balance after event']
  reason text [not null, note: 'Transaction description (e.g., Order ORD-202610-001 purchase)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    customer_id [name: 'idx_cust_loyalty_customer_id', note: 'FK index: loyalty ledger query']
    order_id [name: 'idx_cust_loyalty_order_id', note: 'FK index']
  }

  Note: 'Auditable ledger of customer reward point transactions'
}

Table vouchers {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  code text [not null, unique, note: 'Redeemable code (e.g., TECHSTORE100K, TET2026)']
  description text [null, note: 'Promotional campaign overview']
  discount_type voucher_type [not null, default: 'Percentage']
  discount_value "numeric(18, 2)" [not null, note: 'CHECK discount_value > 0: Percentage or fixed amount']
  min_order_amount "numeric(18, 2)" [not null, default: 0, note: 'CHECK min_order_amount >= 0']
  max_discount_amount "numeric(18, 2)" [null, note: 'Cap on percentage discount (VND)']
  usage_limit integer [not null, default: 100, note: 'CHECK usage_limit > 0: Maximum redemption count']
  used_count integer [not null, default: 0, note: 'CHECK used_count >= 0: Redemptions so far']
  expires_at timestamptz [not null, note: 'Expiration date in UTC']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    code [unique, name: 'idx_vouchers_code']
    // PostgreSQL forbids now() in an index predicate (not IMMUTABLE); check expires_at in the query instead.
    (is_active, expires_at) [name: 'idx_vouchers_active', note: 'Partial index WHERE is_active = true; filter expires_at > now() at query time']
  }

  Note: 'Promotional discount vouchers and store promotional campaigns'
}

Table pos_sessions {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  cashier_user_id uuid [not null, note: 'FK -> users.id: Cashier who operated shift']
  opening_balance "numeric(18, 2)" [not null, default: 0, note: 'CHECK opening_balance >= 0: Drawer initial cash']
  closing_balance "numeric(18, 2)" [null, note: 'Counted physical cash at shift close']
  cash_sales_total "numeric(18, 2)" [not null, default: 0, note: 'Total cash received during shift']
  vietqr_sales_total "numeric(18, 2)" [not null, default: 0, note: 'Total VietQR bank transfer during shift']
  status pos_session_status [not null, default: 'Open']
  opened_at timestamptz [not null, default: `now()`, note: 'Shift start timestamp']
  closed_at timestamptz [null, note: 'Shift end timestamp']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    cashier_user_id [name: 'idx_pos_sessions_cashier_id', note: 'FK index']
    status [name: 'idx_pos_sessions_status']
    opened_at [name: 'idx_pos_sessions_opened_at']
  }

  Note: 'Cash register shift management and drawer reconciliation'
}

Table vietqr_transactions {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  order_id uuid [not null, note: 'FK -> orders.id']
  pos_session_id uuid [null, note: 'FK -> pos_sessions.id']
  transaction_code text [not null, unique, note: 'Bank transfer memo / code (e.g., TS20261003)']
  bank_bin text [not null, note: 'Bank National ID / BIN (e.g., 970422 for MBBank, 970415 for VietinBank)']
  bank_account_number text [not null, note: 'Store receiver bank account']
  amount "numeric(18, 2)" [not null, note: 'CHECK amount > 0: Exact payable order amount']
  qr_content text [not null, note: 'Raw EMVCo VietQR string generated for customer display']
  status vietqr_status [not null, default: 'Pending']
  confirmed_at timestamptz [null, note: 'Webhook notification settlement timestamp']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    order_id [name: 'idx_vietqr_tx_order_id', note: 'FK index']
    pos_session_id [name: 'idx_vietqr_tx_session_id', note: 'FK index']
    transaction_code [unique, name: 'idx_vietqr_tx_code']
    status [name: 'idx_vietqr_tx_status']
  }

  Note: 'Dynamic VietQR payment requests and automated webhook reconciliations'
}

// ============================================================================
// 6. IDENTITY MODULE
// ============================================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  username text [not null, unique, note: 'Unique account login username']
  email text [not null, unique, note: 'Unique email address for notifications']
  password_hash text [not null, note: 'Argon2id or PBKDF2 hashed password']
  full_name text [not null, note: 'Employee display name']
  is_active boolean [not null, default: true, note: 'Account active status']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    username [unique, name: 'idx_users_username']
    email [unique, name: 'idx_users_email']
  }

  Note: 'System user credentials and personnel directory'
}

Table roles {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  name role_type [not null, unique, note: 'Role enum: Admin, Manager, SalesStaff, WarehouseStaff']
  description text [null, note: 'Role authority and access permissions description']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    name [unique, name: 'idx_roles_name']
  }

  Note: 'RBAC authorization roles defining system privileges'
}

Table user_roles {
  user_id uuid [not null, note: 'FK -> users.id (ON DELETE CASCADE)']
  role_id uuid [not null, note: 'FK -> roles.id (ON DELETE CASCADE)']
  assigned_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, role_id) [pk, name: 'pk_user_roles']
    role_id [name: 'idx_user_roles_role_id', note: 'FK index: fast lookup of all users in a role']
  }

  Note: 'Composite join table mapping users to roles (Many-to-Many)'
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`, note: 'Primary Key (UUID)']
  user_id uuid [not null, note: 'FK -> users.id (ON DELETE CASCADE)']
  token_hash text [not null, unique, note: 'SHA-256 hash of the refresh token; the raw token is only returned to the client once']
  expires_at timestamptz [not null, note: 'UTC token expiration']
  is_revoked boolean [not null, default: false, note: 'Revocation flag']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [null]

  indexes {
    user_id [name: 'idx_refresh_tokens_user_id', note: 'FK index']
    token_hash [unique, name: 'idx_refresh_tokens_token_hash']
    (user_id, token_hash) [name: 'idx_refresh_tokens_active', note: 'Supabase Best Practice: Partial index WHERE is_revoked = false']
  }

  Note: 'JWT authentication refresh tokens with revocation support'
}

// ============================================================================
// 7. RELATIONSHIPS (FOREIGN KEYS)
// ============================================================================

// Catalog Relationships
Ref: categories.parent_id > categories.id [delete: set null]
Ref: products.category_id > categories.id [delete: restrict]
Ref: product_variants.product_id > products.id [delete: cascade]

// Inventory Relationships
Ref: inventory_stocks.product_id > products.id [delete: restrict]
Ref: inventory_stocks.(variant_id, product_id) > product_variants.(id, product_id) [delete: restrict]
Ref: inventory_movements.inventory_stock_id > inventory_stocks.id [delete: restrict]
Ref: inventory_movements.performed_by_user_id > users.id [delete: restrict]
Ref: inventory_movements.purchase_order_item_id > purchase_order_items.id [delete: restrict]
Ref: inventory_movements.order_item_id > order_items.id [delete: restrict]
Ref: inventory_movements.order_return_id > order_returns.id [delete: restrict]
Ref: purchase_orders.supplier_id > suppliers.id [delete: restrict]
Ref: purchase_orders.created_by_user_id > users.id [delete: restrict]
Ref: purchase_orders.received_by_user_id > users.id [delete: restrict]
Ref: purchase_order_items.purchase_order_id > purchase_orders.id [delete: cascade]
Ref: purchase_order_items.product_id > products.id [delete: restrict]
Ref: purchase_order_items.(variant_id, product_id) > product_variants.(id, product_id) [delete: restrict]
Ref: serial_imeis.product_id > products.id [delete: restrict]
Ref: serial_imeis.(variant_id, product_id) > product_variants.(id, product_id) [delete: restrict]
Ref: serial_imeis.purchase_order_id > purchase_orders.id [delete: set null]

// Orders Relationships
Ref: orders.customer_id > customers.id [delete: set null]
Ref: orders.cashier_user_id > users.id [delete: restrict]
Ref: orders.pos_session_id > pos_sessions.id [delete: set null]
Ref: orders.voucher_id > vouchers.id [delete: set null]
Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_items.product_id > products.id [delete: restrict]
Ref: order_items.(variant_id, product_id) > product_variants.(id, product_id) [delete: restrict]
Ref: order_items.serial_imei_id > serial_imeis.id [delete: set null]
Ref: order_returns.order_id > orders.id [delete: restrict]
Ref: order_returns.order_item_id > order_items.id [delete: restrict]
Ref: order_returns.processed_by_user_id > users.id [delete: restrict]

// Customers & Sales Relationships
Ref: customer_loyalty_points.customer_id > customers.id [delete: cascade]
Ref: customer_loyalty_points.order_id > orders.id [delete: set null]
Ref: pos_sessions.cashier_user_id > users.id [delete: restrict]
Ref: vietqr_transactions.order_id > orders.id [delete: restrict]
Ref: vietqr_transactions.pos_session_id > pos_sessions.id [delete: set null]

// Identity Relationships
Ref: user_roles.user_id > users.id [delete: cascade]
Ref: user_roles.role_id > roles.id [delete: cascade]
Ref: refresh_tokens.user_id > users.id [delete: cascade]

// ============================================================================
// 8. TABLE GROUPS (MODULE BOUNDARIES FOR VISUALIZATION)
// ============================================================================

TableGroup Catalog {
  categories
  products
  product_variants
}

TableGroup Inventory {
  inventory_stocks
  inventory_movements
  suppliers
  purchase_orders
  purchase_order_items
  serial_imeis
}

TableGroup Orders {
  orders
  order_items
  order_returns
}

TableGroup Customers {
  customers
  customer_loyalty_points
  vouchers
}

TableGroup Sales {
  pos_sessions
  vietqr_transactions
}

TableGroup Identity {
  users
  roles
  user_roles
  refresh_tokens
}
