<Page x:Class="TechStore.Client.Views.Catalog.ProductListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TechStore.Client.Controls"
      xmlns:converters="using:TechStore.Client.Converters"
      xmlns:models="using:TechStore.Client.Models.Catalog"
      xmlns:shell="using:TechStore.Client.Views.Shell"
      Background="{ThemeResource TechStoreCanvasBrush}"
      FontFamily="{StaticResource TechStoreRegularFont}"
      SizeChanged="OnPageSizeChanged"
      Loaded="OnPageLoaded"
      Unloaded="OnPageUnloaded">
    <Page.Resources>
        <converters:ProductImageSourceConverter x:Key="ProductImageSourceConverter" />
        <converters:ProductPriceRangeConverter x:Key="ProductPriceRangeConverter" />
        <converters:ProductActiveLabelConverter x:Key="ProductActiveLabelConverter" />
        <converters:ProductVariantCountConverter x:Key="ProductVariantCountConverter" />
    </Page.Resources>
    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12" MinHeight="36">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ListHeading" IsTabStop="True" AutomationProperties.Name="Số kết quả sản phẩm"
                       VerticalAlignment="Center" Style="{StaticResource TechStoreSectionTextStyle}">
                <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" />
                <Run Text=" sản phẩm" />
            </TextBlock>
            <Button Grid.Column="1" Content="Làm mới" Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource TechStoreButtonStyle}" AutomationProperties.Name="Làm mới danh sách sản phẩm" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <controls:SearchBoxControl Label="Tìm kiếm sản phẩm"
                PlaceholderText="Tên sản phẩm, SKU hoặc barcode"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                SearchCommand="{x:Bind ViewModel.SearchCommand}"
                ClearCommand="{x:Bind ViewModel.ClearSearchCommand}" />
            <Button Grid.Column="1" Content="Tìm kiếm" Command="{x:Bind ViewModel.SearchCommand}"
                    Style="{StaticResource TechStorePrimaryButtonStyle}" VerticalAlignment="Bottom" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="Danh mục" Style="{StaticResource TechStoreCaptionTextStyle}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                          DisplayMemberPath="DisplayPath" SelectedValuePath="Id"
                          SelectedValue="{x:Bind ViewModel.SelectedCategoryId, Mode=TwoWay}"
                          PlaceholderText="Tất cả danh mục" MinHeight="40"
                          AutomationProperties.Name="Lọc theo danh mục" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="Thương hiệu" Style="{StaticResource TechStoreCaptionTextStyle}" />
                <TextBox Text="{x:Bind ViewModel.BrandText, Mode=TwoWay}" PlaceholderText="Nhập thương hiệu"
                         MinHeight="40" AutomationProperties.Name="Lọc theo thương hiệu" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Text="Trạng thái sản phẩm" Style="{StaticResource TechStoreCaptionTextStyle}" />
                <ComboBox SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.ActiveFilter, Mode=TwoWay}"
                          MinHeight="40" AutomationProperties.Name="Lọc trạng thái sản phẩm">
                    <ComboBoxItem Content="Tất cả trạng thái" Tag="all" />
                    <ComboBoxItem Content="Đang hoạt động" Tag="active" />
                    <ComboBoxItem Content="Ngừng hoạt động" Tag="inactive" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.5*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="5">
                <TextBlock Text="Giá tối thiểu (₫)" Style="{StaticResource TechStoreCaptionTextStyle}" />
                <TextBox Text="{x:Bind ViewModel.MinPriceText, Mode=TwoWay}" PlaceholderText="Không giới hạn"
                         InputScope="Number" MinHeight="40" AutomationProperties.Name="Giá tối thiểu" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="Giá tối đa (₫)" Style="{StaticResource TechStoreCaptionTextStyle}" />
                <TextBox Text="{x:Bind ViewModel.MaxPriceText, Mode=TwoWay}" PlaceholderText="Không giới hạn"
                         InputScope="Number" MinHeight="40" AutomationProperties.Name="Giá tối đa" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Text="Thông số (mỗi dòng key=value)" Style="{StaticResource TechStoreCaptionTextStyle}" />
                <TextBox Text="{x:Bind ViewModel.SpecsText, Mode=TwoWay}" PlaceholderText="ram=16&#10;has_5g=true"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58"
                         AutomationProperties.Name="Lọc theo thông số kỹ thuật" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Sắp xếp" VerticalAlignment="Center" Style="{StaticResource TechStoreCaptionTextStyle}" />
                <ComboBox SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                          MinWidth="170" AutomationProperties.Name="Sắp xếp sản phẩm">
                    <ComboBoxItem Content="Mới nhất" Tag="createdAt:desc" />
                    <ComboBoxItem Content="Cũ nhất" Tag="createdAt:asc" />
                    <ComboBoxItem Content="Tên A–Z" Tag="name:asc" />
                    <ComboBoxItem Content="Tên Z–A" Tag="name:desc" />
                    <ComboBoxItem Content="Giá thấp trước" Tag="price:asc" />
                    <ComboBoxItem Content="Giá cao trước" Tag="price:desc" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Mỗi trang" VerticalAlignment="Center" Style="{StaticResource TechStoreCaptionTextStyle}" />
                <ComboBox ItemsSource="{x:Bind ViewModel.PageSizes, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedPageSize, Mode=TwoWay}"
                          MinWidth="72" AutomationProperties.Name="Số sản phẩm mỗi trang" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CategoryError, Mode=OneWay}"
                           Style="{StaticResource TechStoreFieldErrorStyle}"
                           Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.HasCategoryError), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                           Style="{StaticResource TechStoreFieldErrorStyle}"
                           Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.HasValidationError), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.FieldErrorSummary, Mode=OneWay}"
                           Style="{StaticResource TechStoreFieldErrorStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="3" Content="Thử tải danh mục" Command="{x:Bind ViewModel.RetryCategoriesCommand}"
                    Style="{StaticResource TechStoreButtonStyle}"
                    Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.HasCategoryError), Mode=OneWay}" />
            <Button Grid.Column="4" Content="Đặt lại bộ lọc" Command="{x:Bind ViewModel.ResetFiltersCommand}"
                    Style="{StaticResource TechStoreButtonStyle}" />
        </Grid>

        <Grid Grid.Row="5">
            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsLoading), Mode=OneWay}" />
            <StackPanel Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsError), Mode=OneWay}">
                <Border Padding="12" CornerRadius="8" Background="{ThemeResource TechStoreDangerFillBrush}"
                        BorderBrush="{ThemeResource TechStoreDangerStrokeBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TechStoreDangerTextBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Thử lại" Command="{x:Bind ViewModel.RetryCommand}"
                                Style="{StaticResource TechStoreButtonStyle}" />
                    </Grid>
                </Border>
                <TextBlock Text="Đang hiển thị kết quả thành công trước đó cho bộ lọc cũ."
                           Style="{StaticResource TechStoreCaptionTextStyle}"
                           Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.HasResultsForPreviousQuery), Mode=OneWay}" />
            </StackPanel>
            <controls:EmptyStateControl Title="Không có sản phẩm phù hợp"
                Description="Thay đổi từ khóa hoặc bộ lọc để tìm sản phẩm khác."
                ActionText="Đặt lại bộ lọc" ActionCommand="{x:Bind ViewModel.ResetFiltersCommand}"
                IconSource="{StaticResource TechStoreEmptyIcon}"
                Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.ShowEmptyState), Mode=OneWay}" />
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.ShowInitialLoading), Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.ShowInitialLoading, Mode=OneWay}" Width="38" Height="38" />
                <TextBlock Text="Đang tải Catalog" Style="{StaticResource TechStoreBodyTextStyle}" />
            </StackPanel>
            <StackPanel Spacing="10" VerticalAlignment="Center"
                        Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsOutOfRange), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.ResultContext, Mode=OneWay}" Style="{StaticResource TechStoreBodyTextStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <Button Content="Về trang đầu" Command="{x:Bind ViewModel.FirstPageCommand}"
                        Style="{StaticResource TechStorePrimaryButtonStyle}" HorizontalAlignment="Center" />
            </StackPanel>
            <ScrollViewer x:Name="ProductScrollViewer" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ItemsRepeater x:Name="ProductRepeater" ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}"
                               ElementPrepared="OnProductElementPrepared"
                               AutomationProperties.Name="Danh sách sản phẩm">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="258" MinItemHeight="340"
                                           MinColumnSpacing="14" MinRowSpacing="14"
                                           ItemsStretch="Fill" Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductSummary">
                        <Button Padding="0" Background="Transparent" BorderThickness="0"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Click="OnProductItemClick" AutomationProperties.Name="{x:Bind Name}">
                            <Border Padding="12" CornerRadius="{StaticResource TechStorePanelRadius}"
                                    BorderThickness="1" BorderBrush="{ThemeResource TechStoreStrokeBrush}"
                                    Background="{ThemeResource TechStoreSurfaceBrush}" MinHeight="340">
                                <Grid RowSpacing="9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Background="{ThemeResource TechStoreSubtleBrush}"
                                          AutomationProperties.Name="Ảnh sản phẩm, ảnh mẫu không khả dụng">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="34" Foreground="{ThemeResource TechStoreSecondaryTextBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Stretch="UniformToFill" Source="{x:Bind ImageUrl, Converter={StaticResource ProductImageSourceConverter}}"
                                               ImageFailed="OnProductImageFailed" AutomationProperties.Name="Ảnh sản phẩm" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" Style="{StaticResource TechStoreSectionTextStyle}"
                                               MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Tên sản phẩm" />
                                    <TextBlock Grid.Row="2" TextWrapping="Wrap" Style="{StaticResource TechStoreCaptionTextStyle}"
                                               Foreground="{ThemeResource TechStoreSecondaryTextBrush}">
                                        <Run Text="{x:Bind Sku}" /><Run Text=" · " /><Run Text="{x:Bind Brand}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Text="{x:Bind CategoryName}" Style="{StaticResource TechStoreCaptionTextStyle}"
                                               Foreground="{ThemeResource TechStoreSecondaryTextBrush}" MaxLines="1"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="5" Spacing="7">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <controls:StatusBadge Label="{x:Bind IsActive, Converter={StaticResource ProductActiveLabelConverter}}"
                                                                  Tone="Accent" />
                                            <TextBlock Text="{x:Bind VariantCount, Converter={StaticResource ProductVariantCountConverter}}"
                                                       Style="{StaticResource TechStoreCaptionTextStyle}"
                                                       Foreground="{ThemeResource TechStoreSecondaryTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Converter={StaticResource ProductPriceRangeConverter}}"
                                                   Style="{StaticResource TechStoreSectionTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="6" ColumnSpacing="12" MinHeight="40"
              Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.ShowPagination), Mode=OneWay}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource TechStoreCaptionTextStyle}"
                       Foreground="{ThemeResource TechStoreSecondaryTextBrush}">
                <Run Text="Trang " /><Run Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" />
                <Run Text=" / " /><Run Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" />
                <Run Text=" · " /><Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" /><Run Text=" kết quả" />
            </TextBlock>
            <Button Grid.Column="1" Content="Trang trước" Command="{x:Bind ViewModel.PreviousPageCommand}"
                    IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}" Style="{StaticResource TechStoreButtonStyle}" />
            <Button Grid.Column="2" Content="Trang sau" Command="{x:Bind ViewModel.NextPageCommand}"
                    IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}" Style="{StaticResource TechStoreButtonStyle}" />
        </Grid>
    </Grid>
</Page>
