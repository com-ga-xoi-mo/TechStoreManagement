<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<FontFamily x:Key="TechStoreRegularFont">ms-appx:///Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
<FontFamily x:Key="TechStoreMediumFont">ms-appx:///Assets/Fonts/Inter-Medium.ttf#Inter</FontFamily>
<FontFamily x:Key="TechStoreSemiBoldFont">ms-appx:///Assets/Fonts/Inter-SemiBold.ttf#Inter</FontFamily>
<FontFamily x:Key="TechStoreBoldFont">ms-appx:///Assets/Fonts/Inter-Bold.ttf#Inter</FontFamily>
<FontFamily x:Key="TechStoreMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
<Style x:Key="TechStoreBodyTextStyle" TargetType="TextBlock">
<Setter Property="FontFamily" Value="{StaticResource TechStoreRegularFont}" />
<Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Normal" />
<Setter Property="LineHeight" Value="20" /><Setter Property="TextWrapping" Value="Wrap" />
<Setter Property="Foreground" Value="{ThemeResource TechStoreTextBrush}" />
</Style>
<Style x:Key="TechStoreHeadingTextStyle" TargetType="TextBlock">
<Setter Property="FontFamily" Value="{StaticResource TechStoreSemiBoldFont}" />
<Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" />
<Setter Property="LineHeight" Value="28" /><Setter Property="TextWrapping" Value="Wrap" />
<Setter Property="Foreground" Value="{ThemeResource TechStoreTextBrush}" />
</Style>
<Style x:Key="TechStoreSectionTextStyle" TargetType="TextBlock">
<Setter Property="FontFamily" Value="{StaticResource TechStoreSemiBoldFont}" />
<Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
<Setter Property="LineHeight" Value="20" /><Setter Property="TextWrapping" Value="Wrap" />
<Setter Property="Foreground" Value="{ThemeResource TechStoreTextBrush}" />
</Style>
<Style x:Key="TechStoreCaptionTextStyle" TargetType="TextBlock">
<Setter Property="FontFamily" Value="{StaticResource TechStoreMediumFont}" />
<Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" />
<Setter Property="LineHeight" Value="18" /><Setter Property="TextWrapping" Value="Wrap" />
<Setter Property="Foreground" Value="{ThemeResource TechStoreTextBrush}" />
</Style>
<Style x:Key="TechStoreMetricTextStyle" TargetType="TextBlock">
<Setter Property="FontFamily" Value="{StaticResource TechStoreSemiBoldFont}" />
<Setter Property="FontSize" Value="24" /><Setter Property="FontWeight" Value="SemiBold" />
<Setter Property="LineHeight" Value="32" /><Setter Property="TextWrapping" Value="Wrap" />
<Setter Property="Foreground" Value="{ThemeResource TechStoreTextBrush}" />
</Style>
<Style x:Key="TechStoreMonoTextStyle" TargetType="TextBlock">
<Setter Property="FontFamily" Value="{StaticResource TechStoreMonoFont}" />
<Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" />
<Setter Property="LineHeight" Value="18" /><Setter Property="TextWrapping" Value="Wrap" />
<Setter Property="Foreground" Value="{ThemeResource TechStoreTextBrush}" />
</Style>
</ResourceDictionary>
