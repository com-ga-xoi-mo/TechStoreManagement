<Page x:Class="TechStore.Client.Views.Catalog.ProductDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:TechStore.Client.Controls"
      xmlns:converters="using:TechStore.Client.Converters"
      xmlns:models="using:TechStore.Client.Models.Catalog"
      xmlns:shell="using:TechStore.Client.Views.Shell"
      Background="{ThemeResource TechStoreCanvasBrush}"
      FontFamily="{StaticResource TechStoreRegularFont}"
      Loaded="OnPageLoaded">
    <Page.Resources>
        <converters:ProductImageSourceConverter x:Key="ProductImageSourceConverter" />
        <converters:ProductCurrencyConverter x:Key="ProductCurrencyConverter" />
        <converters:ProductActiveLabelConverter x:Key="ProductActiveLabelConverter" />
    </Page.Resources>
    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="10">
            <Button Content="←  Quay lại danh sách" Command="{x:Bind ViewModel.BackCommand}"
                    Style="{StaticResource TechStoreQuietButtonStyle}" HorizontalAlignment="Left"
                    AutomationProperties.Name="Quay lại danh sách sản phẩm" />
            <TextBlock x:Name="DetailHeading" Text="Chi tiết sản phẩm"
                       Style="{StaticResource TechStoreHeadingTextStyle}" IsTabStop="True" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsLoading), Mode=OneWay}" />
            <controls:EmptyStateControl Title="Không tìm thấy sản phẩm"
                Description="Sản phẩm có thể đã bị xóa hoặc không còn khả dụng. Quay lại danh sách để tiếp tục."
                ActionText="Quay lại danh sách" ActionCommand="{x:Bind ViewModel.BackCommand}"
                IconSource="{StaticResource TechStoreEmptyIcon}"
                Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsNotFound), Mode=OneWay}" />
            <StackPanel Spacing="12" Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsError), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Style="{StaticResource TechStoreFieldErrorStyle}" />
                <Button Content="Thử tải lại" Command="{x:Bind ViewModel.RetryCommand}"
                        Style="{StaticResource TechStoreButtonStyle}" HorizontalAlignment="Left" />
            </StackPanel>
            <ScrollViewer Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.IsContent), Mode=OneWay}">
                <StackPanel Spacing="18" MaxWidth="1100" HorizontalAlignment="Left">
                    <Grid ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border CornerRadius="{StaticResource TechStorePanelRadius}" Background="{ThemeResource TechStoreSubtleBrush}"
                                BorderBrush="{ThemeResource TechStoreStrokeBrush}" BorderThickness="1" MinHeight="260">
                            <Grid>
                                <FontIcon Glyph="&#xE8B9;" FontSize="44" Foreground="{ThemeResource TechStoreSecondaryTextBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{x:Bind ViewModel.Product.ImageUrl, Mode=OneWay, Converter={StaticResource ProductImageSourceConverter}}"
                                       Stretch="UniformToFill" ImageFailed="OnProductImageFailed" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind ViewModel.Product.Name, Mode=OneWay}"
                                       Style="{StaticResource TechStoreHeadingTextStyle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <controls:StatusBadge Label="{x:Bind ViewModel.Product.IsActive, Mode=OneWay, Converter={StaticResource ProductActiveLabelConverter}}"
                                                      Tone="Accent" />
                                <TextBlock Text="{x:Bind ViewModel.Product.CategoryName, Mode=OneWay}"
                                           Style="{StaticResource TechStoreCaptionTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource TechStoreBodyTextStyle}"
                                       Foreground="{ThemeResource TechStoreSecondaryTextBrush}">
                                <Run Text="SKU: " /><Run Text="{x:Bind ViewModel.Product.Sku, Mode=OneWay}" />
                                <Run Text="   ·   Hãng: " /><Run Text="{x:Bind ViewModel.Product.Brand, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource TechStoreBodyTextStyle}">
                                <Run Text="Barcode: " /><Run Text="{x:Bind ViewModel.Product.Barcode, Mode=OneWay}" />
                                <Run Text="   ·   Theo dõi serial: " /><Run Text="{x:Bind ViewModel.Product.IsSerialTracked, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{x:Bind ViewModel.Product.BasePrice, Mode=OneWay, Converter={StaticResource ProductCurrencyConverter}}"
                                       Style="{StaticResource TechStoreMetricTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Giá vốn:" Style="{StaticResource TechStoreCaptionTextStyle}"
                                           Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.Product.CostPrice, Mode=OneWay, Converter={StaticResource ProductCurrencyConverter}}"
                                           Style="{StaticResource TechStoreCaptionTextStyle}"
                                           Foreground="{ThemeResource TechStoreSecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource TechStorePanelStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Mô tả" Style="{StaticResource TechStoreSectionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Product.Description, Mode=OneWay}"
                                       TextWrapping="Wrap" Style="{StaticResource TechStoreBodyTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TechStorePanelStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Thông số sản phẩm" Style="{StaticResource TechStoreSectionTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Product.Specs, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnSpacing="18">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource TechStoreCaptionTextStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource TechStoreBodyTextStyle}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Không có thông số bổ sung." Style="{StaticResource TechStoreCaptionTextStyle}"
                                       Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.HasNoSpecs), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource TechStorePanelStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Biến thể" Style="{StaticResource TechStoreSectionTextStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Product.Variants, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProductVariant">
                                        <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="8"
                                                Background="{ThemeResource TechStoreCanvasBrush}"
                                                BorderBrush="{ThemeResource TechStoreStrokeBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind VariantName}" Style="{StaticResource TechStoreBodyTextStyle}" />
                                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource TechStoreCaptionTextStyle}"
                                                                   Foreground="{ThemeResource TechStoreSecondaryTextBrush}">
                                                            <Run Text="SKU: " /><Run Text="{x:Bind Sku}" />
                                                            <Run Text="   ·   Barcode: " /><Run Text="{x:Bind Barcode}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Price, Converter={StaticResource ProductCurrencyConverter}}"
                                                               Style="{StaticResource TechStoreSectionTextStyle}" VerticalAlignment="Center" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{x:Bind EffectiveSpecs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock TextWrapping="Wrap" Style="{StaticResource TechStoreCaptionTextStyle}"
                                                                       Foreground="{ThemeResource TechStoreSecondaryTextBrush}">
                                                                <Run Text="{Binding Key}" /><Run Text=": " /><Run Text="{Binding Value}" />
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Sản phẩm này không có biến thể." Style="{StaticResource TechStoreCaptionTextStyle}"
                                       Visibility="{x:Bind shell:ShellPage.VisibilityFor(ViewModel.HasNoVariants), Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
